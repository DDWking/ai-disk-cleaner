<Project Sdk="Microsoft.NET.Sdk">

  <!-- 手工跑的解析器检查：dotnet run 本目录
       直接编译主工程里真正在用的 AiNoteParser.cs / CleanItem.cs，
       不复制逻辑，所以测的就是发出去的那份代码。 -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>AiNoteParserCheck</AssemblyName>
    <RootNamespace>AiNoteParserCheck</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="LocStub.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\AiNoteParser.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Models\CleanItem.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Models\ItemAiView.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\AiVerdict.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\CleanListSnapshot.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\AppSignatures.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\ProtectedPaths.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\PathRedactor.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\AppPaths.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Services\ItemAiPrompt.cs" />
    <Compile Include="..\..\src\AiDiskCleaner\Models\FileEntry.cs" />
    <!-- CleanItem 的用途分类引用 CleanPurpose 枚举（证据驱动分类，规则契约的一部分） -->
    <Compile Include="..\..\src\AiDiskCleaner\Services\CleanRules\CleanPurpose.cs" />
    <!-- CleanItem 现在带规则声明的证据等级（EvidenceLevel），枚举在 Models 里；
         批量勾选按它判断，不再靠路径里有没有 "cache" 这种字符串猜。 -->
    <Compile Include="..\..\src\AiDiskCleaner\Models\CleanEvidence.cs" />
  </ItemGroup>

</Project>
