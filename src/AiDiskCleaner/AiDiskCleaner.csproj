<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.18362.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>AiDiskCleaner</RootNamespace>
    <AssemblyName>AiDiskCleaner</AssemblyName>
    <Version>3.0.1</Version>
    <FileVersion>3.0.1.0</FileVersion>
    <InformationalVersion>3.0.1</InformationalVersion>
    <Product>大扫货</Product>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\logo-256.png" />
    <Resource Include="Assets\app.ico" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\vendor\Bulk-Crap-Uninstaller\source\UninstallTools\UninstallTools.csproj" />
    <ProjectReference Include="..\..\vendor\Bulk-Crap-Uninstaller\source\StoreAppHelper\StoreAppHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
    <ProjectReference Include="..\..\vendor\Bulk-Crap-Uninstaller\source\SteamHelper\SteamHelper.csproj">
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\vendor\Bulk-Crap-Uninstaller\Licence.txt" Link="THIRD-PARTY\BCUninstaller\Licence.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\vendor\Bulk-Crap-Uninstaller\NOTICE" Link="THIRD-PARTY\BCUninstaller\NOTICE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- v3.0：Pi sidecar 的嵌入项删掉了（Node 侧车与聊天通道整体下线）。
       判定通道只是一次 HTTP 调用，不需要外部进程，发布包也小了一圈。 -->

  <!-- Non-reference helper executables still need their managed entry assemblies. -->
  <Target Name="IncludeHelperEntryAssemblies" AfterTargets="ResolveProjectReferences">
    <MSBuild Projects="@(ProjectReference)"
             Targets="GetTargetPath"
             Condition="'%(ProjectReference.ReferenceOutputAssembly)' == 'false'">
      <Output TaskParameter="TargetOutputs" ItemName="_HelperEntryAssemblies" />
    </MSBuild>
    <ItemGroup>
      <Content Include="@(_HelperEntryAssemblies)"
               Link="%(Filename)%(Extension)"
               CopyToOutputDirectory="PreserveNewest"
               CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
