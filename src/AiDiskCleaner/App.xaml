<Application x:Class="AiDiskCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#000000"/>
        <SolidColorBrush x:Key="PanelLeft" Color="#080808"/>
        <SolidColorBrush x:Key="PanelRight" Color="#121212"/>
        <SolidColorBrush x:Key="Border" Color="#3A3A3A"/>
        <SolidColorBrush x:Key="Accent" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AccentDim" Color="#C8C8C8"/>
        <SolidColorBrush x:Key="Text" Color="#F2F2F2"/>
        <SolidColorBrush x:Key="TextDim" Color="#8A8A8A"/>
        <SolidColorBrush x:Key="TextMuted" Color="#5A5A5A"/>
        <SolidColorBrush x:Key="SelectBg" Color="#282828"/>
        <SolidColorBrush x:Key="HoverBg" Color="#1A1A1A"/>
        <SolidColorBrush x:Key="CloseHoverBg" Color="#4A0000"/>
        <SolidColorBrush x:Key="Placeholder" Color="#5A5A5A"/>
        <SolidColorBrush x:Key="Overlay" Color="#D0000000"/>
        <SolidColorBrush x:Key="RowAlt" Color="#0A0A0A"/>
        <SolidColorBrush x:Key="GridLine" Color="#242424"/>
        <SolidColorBrush x:Key="CloseHoverFg" Color="#FF6B6B"/>
        <FontFamily x:Key="AppFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        <sys:String x:Key="SearchHintText">搜索路径 / 文件名</sys:String>
    </Application.Resources>
</Application>
