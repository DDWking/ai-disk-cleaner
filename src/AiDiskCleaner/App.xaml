<Application x:Class="AiDiskCleaner.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0B0F0C"/>
        <SolidColorBrush x:Key="PanelLeft" Color="#07140C"/>
        <SolidColorBrush x:Key="PanelRight" Color="#141C16"/>
        <SolidColorBrush x:Key="Border" Color="#1F3D2A"/>
        <SolidColorBrush x:Key="Accent" Color="#39FF88"/>
        <SolidColorBrush x:Key="AccentDim" Color="#3AC46A"/>
        <SolidColorBrush x:Key="Text" Color="#7DFF9A"/>
        <SolidColorBrush x:Key="TextDim" Color="#6B8F74"/>
        <SolidColorBrush x:Key="TextMuted" Color="#2E6B45"/>
        <SolidColorBrush x:Key="SelectBg" Color="#0E3A1C"/>
        <SolidColorBrush x:Key="HoverBg" Color="#122018"/>
        <SolidColorBrush x:Key="CloseHoverBg" Color="#5A1A1A"/>
        <SolidColorBrush x:Key="Placeholder" Color="#3D5C45"/>
        <SolidColorBrush x:Key="Overlay" Color="#CC000000"/>
        <SolidColorBrush x:Key="RowAlt" Color="#0C1410"/>
        <SolidColorBrush x:Key="GridLine" Color="#263226"/>
        <SolidColorBrush x:Key="CloseHoverFg" Color="#FF6B6B"/>
        <FontFamily x:Key="AppFont">Cascadia Mono, Consolas, Courier New</FontFamily>
        <sys:String x:Key="SearchHintText">搜索路径 / 文件名</sys:String>
    </Application.Resources>
</Application>
