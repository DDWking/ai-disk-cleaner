<Window x:Class="AiDiskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大扫货" Height="800" Width="1320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0F0C"
        Foreground="#C8F5D0"
        FontFamily="Cascadia Mono, Consolas, Courier New">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#6B8F74"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#1F3D2A"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="SeparatorBrush" Value="#1F3D2A"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#163322"/>
          <Setter Property="Foreground" Value="#39FF88"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#0B0F0C"/>
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#163322"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#122018"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Setter Property="Padding" Value="2,3"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#163322"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="BorderBrush" Value="#39FF88"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0,24,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    RecognizesAccessKey="False"/>
                  <TextBlock Grid.Column="1" Text="▾" Foreground="#39FF88"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             FontSize="11" Margin="0,0,4,1"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="None">
                <Border Background="#111814" BorderBrush="#39FF88" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="BorderBrush" Value="#39FF88"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CaptionButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#6B8F74"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#163322"/>
                <Setter Property="Foreground" Value="#39FF88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CaptionCloseButton" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#5A1A1A"/>
                <Setter Property="Foreground" Value="#FF6B6B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="GhostButton">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#6B8F74"/>
      <Setter Property="BorderBrush" Value="#1F3D2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="Background" Value="#0B0F0C"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0B0F0C" BorderBrush="#1F3D2A" BorderThickness="0,0,0,1" Padding="8,6,4,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="大扫货" Foreground="#39FF88" FontSize="14"
                   VerticalAlignment="Center" Margin="8,0,16,0"/>
        <ComboBox x:Name="DriveBox" Grid.Column="1" Width="72" VerticalAlignment="Center" Margin="0,0,8,0"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="ScanButton" Grid.Column="2" Content="[ scan ]" Style="{StaticResource PrimaryButton}"
                Margin="0,0,8,0" Click="ScanButton_Click"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="StopButton" Grid.Column="3" Content="[ stop ]" Style="{StaticResource GhostButton}"
                Margin="0,0,16,0" IsEnabled="False" Click="StopButton_Click"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Grid Grid.Column="4" MaxWidth="340" HorizontalAlignment="Left">
          <TextBox x:Name="SearchBox" Height="28" Padding="8,4" VerticalContentAlignment="Center"
                   BorderBrush="#1F3D2A" Background="#111814" Foreground="#39FF88"
                   CaretBrush="#39FF88" BorderThickness="1"
                   FontFamily="Cascadia Mono, Consolas, Courier New"
                   WindowChrome.IsHitTestVisibleInChrome="True"
                   TextChanged="SearchBox_TextChanged"/>
          <TextBlock x:Name="SearchHint" Text="search /path" Foreground="#3D5C45" Margin="10,0,0,0"
                     VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="VolumeText" Foreground="#6B8F74" Margin="0,0,16,0" Text=""/>
          <TextBlock x:Name="HeaderStats" Foreground="#39FF88" Text="ready"/>
        </StackPanel>
        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="—" Style="{StaticResource CaptionButton}" Click="MinButton_Click"/>
          <Button x:Name="MaxButton" Content="□" Style="{StaticResource CaptionButton}" Click="MaxButton_Click"/>
          <Button Content="×" Style="{StaticResource CaptionCloseButton}" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="ScanProgressPanel" DockPanel.Dock="Top" Background="#111814" BorderBrush="#1F3D2A"
            BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="ScanProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                     Foreground="#39FF88" Background="#1F3D2A" BorderThickness="0"/>
        <TextBlock x:Name="ScanProgressText" Grid.Column="1" Foreground="#6B8F74" Margin="12,0,0,0"
                   VerticalAlignment="Center" Text="scanning..."/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#0B0F0C" BorderBrush="#1F3D2A" BorderThickness="0,1,0,0" Padding="12,7">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="FileCountText" Text="0 files" Foreground="#C8F5D0"/>
        <TextBlock Text="  |  " Foreground="#1F3D2A"/>
        <TextBlock x:Name="TotalSizeText" Text="0 KB" Foreground="#39FF88"/>
        <TextBlock Text="  |  " Foreground="#1F3D2A"/>
        <TextBlock x:Name="ElapsedText" Text="—" Foreground="#6B8F74"/>
        <TextBlock Text="  |  " Foreground="#1F3D2A"/>
        <TextBlock x:Name="CleanHintText" Text="scan to analyze" Foreground="#6B8F74"/>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400"/>
        <ColumnDefinition Width="1"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#0B0F0C" BorderBrush="#1F3D2A" BorderThickness="0,0,1,0">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PATH" Foreground="#3D5C45" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="PCT" Foreground="#3D5C45" FontSize="11" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="SIZE" Foreground="#3D5C45" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <TreeView x:Name="DirTree" Padding="4,0,4,8"
                    SelectedItemChanged="DirTree_SelectedItemChanged"/>
        </DockPanel>
      </Border>

      <Border Grid.Column="1" Background="#1F3D2A"/>

      <Border Grid.Column="2" Background="#0B0F0C">
        <DockPanel>
          <TextBlock x:Name="PathCrumb" DockPanel.Dock="Top" Margin="12,8,12,4" Foreground="#39FF88" FontSize="12"/>
          <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="None"
                    BorderThickness="0" RowHeight="26"
                    AlternatingRowBackground="#0E1510"
                    RowBackground="#0B0F0C" Background="#0B0F0C"
                    HorizontalGridLinesBrush="#1F3D2A" EnableRowVirtualization="True"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    MouseDoubleClick="FileGrid_MouseDoubleClick">
            <DataGrid.Columns>
              <DataGridTextColumn Header="NAME" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
              <DataGridTextColumn Header="PCT" Binding="{Binding PercentText}" SortMemberPath="Size" Width="70">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="#6B8F74"/>
                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="SIZE" Binding="{Binding SizeText}" SortMemberPath="Size" Width="92">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="#39FF88"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTemplateColumn Header="" Width="140" SortMemberPath="Size">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Height="6" Margin="4,0" Background="#1F3D2A" VerticalAlignment="Center">
                      <Border Height="6" Background="#39FF88" HorizontalAlignment="Left"
                              Width="{Binding SizeBarWidth}"/>
                    </Border>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="TYPE" Binding="{Binding KindText}" SortMemberPath="Category" Width="80"/>
              <DataGridTextColumn Header="FILES" Binding="{Binding ItemText}" SortMemberPath="FileCount" Width="80">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="#6B8F74"/>
                    <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="MTIME" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="136"/>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
