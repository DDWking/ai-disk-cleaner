<Window x:Class="AiDiskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:AiDiskCleaner.Controls"
        Title="AI 磁盘清理" Height="760" Width="1240"
        WindowStartupLocation="CenterScreen">
  <DockPanel>
    <!-- 顶部工具栏 -->
    <Border DockPanel.Dock="Top" Background="#1E293B" Padding="10,8">
      <StackPanel Orientation="Horizontal">
        <TextBlock Text="🧹 AI 磁盘清理" Foreground="#E2E8F0" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/>
        <ComboBox x:Name="DriveBox" Width="80" VerticalAlignment="Center" Margin="0,0,8,0"/>
        <Button x:Name="ScanButton" Content="🔍 扫描" Padding="12,5" Margin="0,0,8,0" Background="#2563EB" Foreground="White" BorderThickness="0" Click="ScanButton_Click"/>
        <Button x:Name="StopButton" Content="⏹ 停止" Padding="12,5" Margin="0,0,16,0" IsEnabled="False" Click="StopButton_Click"/>
        <TextBox x:Name="SearchBox" Width="280" VerticalAlignment="Center" TextChanged="SearchBox_TextChanged"/>
        <TextBlock x:Name="HeaderStats" Foreground="#94A3B8" VerticalAlignment="Center" Margin="16,0,0,0" Text="就绪"/>
      </StackPanel>
    </Border>

    <!-- 底部状态栏 -->
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem><TextBlock x:Name="FileCountText" Text="0 个文件"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="TotalSizeText" Text="0 B"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="ElapsedText" Text="—"/></StatusBarItem>
      <Separator/>
      <StatusBarItem><TextBlock x:Name="CleanHintText" Text="扫描后显示 AI 清理建议"/></StatusBarItem>
    </StatusBar>

    <!-- 主区 -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="260"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- 左侧目录树 -->
      <TreeView x:Name="DirTree" Grid.Column="0" Margin="6" Background="#F8FAFC" BorderThickness="0"
                SelectedItemChanged="DirTree_SelectedItemChanged"/>

      <!-- 右侧：文件列表 + TreeMap -->
      <Grid Grid.Column="1">
        <Grid.RowDefinitions>
          <RowDefinition Height="55*"/>
          <RowDefinition Height="45*"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="FileGrid" Grid.Row="0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                  BorderThickness="0" RowHeight="24">
          <DataGrid.Columns>
            <DataGridTextColumn Header="名称" Binding="{Binding Name}" SortMemberPath="Name" Width="2*"/>
            <DataGridTextColumn Header="路径" Binding="{Binding FullPath}" SortMemberPath="FullPath" Width="3*"/>
            <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90"/>
            <DataGridTextColumn Header="修改时间" Binding="{Binding ModifiedText}" SortMemberPath="Modified" Width="130"/>
            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" SortMemberPath="Category" Width="70"/>
            <DataGridTextColumn Header="闲置" Binding="{Binding AgeText}" SortMemberPath="AgeDays" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="TreemapCrumb" Grid.Row="0" Margin="8,4,8,2" Foreground="#2563EB" FontSize="12"/>
          <controls:TreeMapControl x:Name="TreeMap" Grid.Row="1" Margin="6,0,6,6"
                                   DirectoryClicked="TreeMap_DirectoryClicked"/>
        </Grid>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
