<Window x:Class="AiDiskCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="大扫货" Height="800" Width="1280"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0F0C"
        Foreground="#C8F5D0"
        FontFamily="Cascadia Mono, Consolas, Courier New">
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                  CornerRadius="0" UseAeroCaptionButtons="False"/>
  </WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
    </Style>
    <Style TargetType="DataGridColumnHeader">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#6B8F74"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="BorderBrush" Value="#1F3D2A"/>
      <Setter Property="BorderThickness" Value="0,0,0,1"/>
      <Setter Property="SeparatorBrush" Value="#1F3D2A"/>
    </Style>
    <Style TargetType="DataGridCell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#163322"/>
          <Setter Property="Foreground" Value="#39FF88"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="DataGridRow">
      <Setter Property="Background" Value="#0B0F0C"/>
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#163322"/>
          <Setter Property="Foreground" Value="#39FF88"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#122018"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#163322"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#39FF88"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#163322"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#39FF88"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#163322"/>
    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Width" Value="16"/>
      <Setter Property="Height" Value="16"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border Background="Transparent">
              <Path x:Name="arrow" Data="M 1,1 L 1,9 L 8,5 Z" Fill="#6B8F74"
                    HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="arrow" Property="Data" Value="M 0,2 L 8,2 L 4,8 Z"/>
                <Setter TargetName="arrow" Property="Fill" Value="#39FF88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TreeView">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="#7DFF9A"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    </Style>
    <Style TargetType="TreeViewItem">
      <Setter Property="Foreground" Value="#C8F5D0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="2,3"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TreeViewItem">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <ToggleButton x:Name="Expander" Style="{StaticResource ExpandCollapseToggleStyle}"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                            ClickMode="Press"/>
              <Border x:Name="Bd" Grid.Column="1"
                      Background="{TemplateBinding Background}"
                      Padding="{TemplateBinding Padding}"
                      SnapsToDevicePixels="True">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
              </Border>
              <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                              Margin="16,0,0,0" Visibility="Collapsed"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#0E3A1C"/>
                <Setter Property="Foreground" Value="#7DFF9A"/>
              </Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsSelected" Value="True"/>
                  <Condition Property="IsSelectionActive" Value="False"/>
                </MultiTrigger.Conditions>
                <Setter TargetName="Bd" Property="Background" Value="#0E3A1C"/>
                <Setter Property="Foreground" Value="#7DFF9A"/>
              </MultiTrigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#163322"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="BorderBrush" Value="#39FF88"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="8,0,24,0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="22"/>
                  </Grid.ColumnDefinitions>
                  <ContentPresenter Grid.Column="0"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Content="{TemplateBinding SelectionBoxItem}"
                                    ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                    ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                    RecognizesAccessKey="False"/>
                  <TextBlock Grid.Column="1" Text="▾" Foreground="#39FF88"
                             VerticalAlignment="Center" HorizontalAlignment="Center"
                             FontSize="11" Margin="0,0,4,1"/>
                </Grid>
              </Border>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                     Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                     PopupAnimation="None">
                <Border Background="#111814" BorderBrush="#39FF88" BorderThickness="1"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                  <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border Background="Transparent"/>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox" x:Key="TermTextBox">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="BorderBrush" Value="#1F3D2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CaretBrush" Value="#39FF88"/>
      <Setter Property="SelectionBrush" Value="#163322"/>
      <Setter Property="SelectionTextBrush" Value="#39FF88"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <Grid Margin="8,0">
                <ScrollViewer x:Name="PART_ContentHost"
                              Margin="0"
                              Padding="0"
                              HorizontalAlignment="Stretch"
                              VerticalAlignment="Stretch"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              CanContentScroll="False"
                              Focusable="False"/>
                <TextBlock x:Name="Placeholder" Text="搜索路径 / 文件名"
                           Foreground="#3D5C45"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"/>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="Placeholder" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="#39FF88"/>
                <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="PrimaryButton">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#39FF88"/>
      <Setter Property="BorderBrush" Value="#39FF88"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CaptionButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#6B8F74"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="40"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#163322"/>
                <Setter Property="Foreground" Value="#39FF88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="CaptionCloseButton" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#5A1A1A"/>
                <Setter Property="Foreground" Value="#FF6B6B"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Button" x:Key="GhostButton">
      <Setter Property="Background" Value="#111814"/>
      <Setter Property="Foreground" Value="#6B8F74"/>
      <Setter Property="BorderBrush" Value="#1F3D2A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="TermScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="bd" Background="#1F3D2A" CornerRadius="0" Margin="1"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#39FF88"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#39FF88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="TermVerticalScrollBar" TargetType="ScrollBar">
      <Grid Background="#0B0F0C">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource TermScrollThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="TermHorizontalScrollBar" TargetType="ScrollBar">
      <Grid Background="#0B0F0C">
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource TermScrollThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="#0B0F0C"/>
      <Setter Property="Foreground" Value="#1F3D2A"/>
      <Setter Property="Width" Value="8"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="8"/>
          <Setter Property="MinWidth" Value="8"/>
          <Setter Property="Template" Value="{StaticResource TermVerticalScrollBar}"/>
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template" Value="{StaticResource TermHorizontalScrollBar}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="#1F3D2A"/>
      <Setter Property="Width" Value="6"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
      <Setter Property="ShowsPreview" Value="False"/>
      <Setter Property="Cursor" Value="SizeWE"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border x:Name="bd" Background="{TemplateBinding Background}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#39FF88"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="bd" Property="Background" Value="#39FF88"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#0B0F0C" BorderBrush="#1F3D2A" BorderThickness="0,0,0,1" Padding="8,6,4,6">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Column="0" Text="大扫货" Foreground="#39FF88" FontSize="14"
                   VerticalAlignment="Center" Margin="8,0,16,0"/>
        <ComboBox x:Name="DriveBox" Grid.Column="1" Width="72" VerticalAlignment="Center" Margin="0,0,8,0"
                  WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="ScanButton" Grid.Column="2" Content="扫描" Style="{StaticResource PrimaryButton}"
                Margin="0,0,8,0" Click="ScanButton_Click"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <Button x:Name="StopButton" Grid.Column="3" Content="停止" Style="{StaticResource GhostButton}"
                Margin="0,0,16,0" IsEnabled="False" Click="StopButton_Click"
                WindowChrome.IsHitTestVisibleInChrome="True"/>
        <TextBox x:Name="SearchBox" Grid.Column="4" Width="220" MaxWidth="340"
                 HorizontalAlignment="Left" VerticalAlignment="Center"
                 Style="{StaticResource TermTextBox}"
                 WindowChrome.IsHitTestVisibleInChrome="True"
                 TextChanged="SearchBox_TextChanged"/>
        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
          <TextBlock x:Name="VolumeText" Foreground="#6B8F74" Margin="0,0,16,0" Text=""/>
          <TextBlock x:Name="HeaderStats" Foreground="#39FF88" Text="就绪"/>
        </StackPanel>
        <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Content="—" Style="{StaticResource CaptionButton}" Click="MinButton_Click"/>
          <Button x:Name="MaxButton" Content="□" Style="{StaticResource CaptionButton}" Click="MaxButton_Click"/>
          <Button Content="×" Style="{StaticResource CaptionCloseButton}" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="ScanProgressPanel" DockPanel.Dock="Top" Background="#111814" BorderBrush="#1F3D2A"
            BorderThickness="0,0,0,1" Padding="12,8" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="ScanProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"
                     Foreground="#39FF88" Background="#1F3D2A" BorderThickness="0"/>
        <TextBlock x:Name="ScanProgressText" Grid.Column="1" Foreground="#6B8F74" Margin="12,0,0,0"
                   VerticalAlignment="Center" Text="正在扫描…"/>
      </Grid>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#0B0F0C" BorderBrush="#1F3D2A" BorderThickness="0,1,0,0" Padding="12,7">
      <StackPanel Orientation="Horizontal">
        <TextBlock x:Name="FileCountText" Text="0 个文件" Foreground="#C8F5D0"/>
        <TextBlock Text="  |  " Foreground="#1F3D2A"/>
        <TextBlock x:Name="TotalSizeText" Text="0 KB" Foreground="#39FF88"/>
        <TextBlock Text="  |  " Foreground="#1F3D2A"/>
        <TextBlock x:Name="ElapsedText" Text="—" Foreground="#6B8F74"/>
        <TextBlock Text="  |  " Foreground="#1F3D2A"/>
        <TextBlock x:Name="CleanHintText" Text="扫描后分析" Foreground="#6B8F74"/>
      </StackPanel>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="320"/>
        <ColumnDefinition Width="6"/>
        <ColumnDefinition Width="380" MinWidth="220"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="#07140C">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="10,8,10,4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="70"/>
              <ColumnDefinition Width="80"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="PathCrumb" Text="路径" Foreground="#2E6B45" FontSize="11"/>
            <TextBlock Grid.Column="1" Text="占比" Foreground="#2E6B45" FontSize="11" HorizontalAlignment="Right"/>
            <TextBlock Grid.Column="2" Text="大小" Foreground="#2E6B45" FontSize="11" HorizontalAlignment="Right"/>
          </Grid>
          <TreeView x:Name="DirTree" Padding="4,0,4,8"
                    Background="#07140C"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectedItemChanged="DirTree_SelectedItemChanged"/>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1"/>

      <Border Grid.Column="2" Background="#141C16">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Margin="10,8,10,4" Text="扩展名 / 类型" Foreground="#7A9A82" FontSize="11"/>
          <DataGrid x:Name="ExtGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    CanUserSortColumns="True" HeadersVisibility="Column" GridLinesVisibility="None"
                    BorderThickness="0" RowHeight="24"
                    AlternatingRowBackground="#1A241C"
                    RowBackground="#141C16" Background="#141C16"
                    HorizontalGridLinesBrush="#2A3A2E" EnableRowVirtualization="True"
                    SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Resources>
              <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}"/>
            </DataGrid.Resources>
            <DataGrid.ColumnHeaderStyle>
              <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="#141C16"/>
                <Setter Property="Foreground" Value="#7A9A82"/>
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="10,7"/>
                <Setter Property="BorderBrush" Value="#2A3A2E"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
              </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.RowStyle>
              <Style TargetType="DataGridRow">
                <Setter Property="Background" Value="#141C16"/>
                <Setter Property="Foreground" Value="#B7D4BE"/>
                <Style.Triggers>
                  <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#243328"/>
                    <Setter Property="Foreground" Value="#8FE8B0"/>
                  </Trigger>
                  <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1C271F"/>
                  </Trigger>
                </Style.Triggers>
              </Style>
            </DataGrid.RowStyle>
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="" Width="14">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Border Width="8" Height="8" Margin="2,0,0,0" VerticalAlignment="Center"
                            Background="{Binding Color}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="扩展名" Binding="{Binding Extension}" SortMemberPath="Extension" Width="80"/>
              <DataGridTextColumn Header="类型" Binding="{Binding TypeName}" SortMemberPath="TypeName" Width="*"/>
              <DataGridTextColumn Header="占比" Binding="{Binding PercentText}" SortMemberPath="Size" Width="56">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="#7A9A82"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="72">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="#8FE8B0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>
