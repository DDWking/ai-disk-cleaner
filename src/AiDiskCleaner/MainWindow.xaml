    </Style>
    <Style TargetType="Button" x:Key="NavButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- 文字链接式入口：不占一整排按钮，但保留键盘焦点 -->
    <Style TargetType="Button" x:Key="LinkButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="Transparent" Padding="0,1">
              <TextBlock Text="{TemplateBinding Content}"
                         Foreground="{TemplateBinding Foreground}"
                         TextDecorations="Underline"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 分区标题：无整圈边框，靠留白与一条细分隔线分区；整行可点展开/收起。
         有键盘焦点样式，折叠/展开状态由箭头 + 可访问名称共同表达（不只靠颜色）。 -->
    <Style TargetType="Button" x:Key="SectionHeaderButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,11"/>
      <Setter Property="Margin" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <!-- 分区容器自己已经有左侧色带与背景层级，标题下再加一条细底纹
                 把「标题区」和「内容行」分开就够了，不要整圈厚重边框。 -->
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="0,0,0,2"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 箭头面包屑返回：以箭头为主，不做成大按钮；整块可点、可键盘聚焦。
         点击区含箭头与标题，ToolTip 为「返回清理中心」。 -->
    <Style TargetType="Button" x:Key="BreadcrumbButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6,3"/>
      <Setter Property="Margin" Value="0,0,10,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 轻量导航箭头：点击区 22x24，悬停才显底色，带可访问名称与键盘焦点 -->
    <Style TargetType="Button" x:Key="ChevronButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="24"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="3">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="GhostButton">
      <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="13,6"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="7"
                    Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                       To="0.97" Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                       To="0.97" Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                       To="1" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                       To="1" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Button" x:Key="NavRailTabButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center">
                <ContentPresenter.RenderTransform>
                  <TranslateTransform x:Name="hoverShift" X="0"/>
                </ContentPresenter.RenderTransform>
              </ContentPresenter>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="hoverShift" Storyboard.TargetProperty="X"
                                       To="2.5" Duration="0:0:0.14">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="hoverShift" Storyboard.TargetProperty="X"
                                       To="0" Duration="0:0:0.15">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                       To="0.97" Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                       To="0.97" Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                       To="1" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                       To="1" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 一级导航标签按钮：底部指示条 + 选中高亮 -->
    <Style TargetType="Button" x:Key="MainTabButton">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="14,9,14,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid Background="Transparent">
              <Border x:Name="bd" Background="{TemplateBinding Background}"
                      CornerRadius="6,6,0,0" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="indicator" Height="2.5" VerticalAlignment="Bottom"
                      Margin="10,0" CornerRadius="1.5"
                      Background="{TemplateBinding BorderBrush}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- 带文字的图标按钮：核心操作（AI 分析 / 清理已选项目）用「图标 + 文字」，不裸图标 -->
    <Style TargetType="Button" x:Key="IconTextButton" BasedOn="{StaticResource GhostButton}">
      <Setter Property="Padding" Value="10,5"/>
    </Style>

    <!-- 胶囊按钮：辅助但需要「按钮感」的入口（筛选/已选）。 -->
    <Style TargetType="Button" x:Key="ChipButton">
      <Setter Property="Background" Value="{DynamicResource CardSurface}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="bd" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6" Padding="{TemplateBinding Padding}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="pressScale" ScaleX="1" ScaleY="1"/>
              </Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBg}"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BorderStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                       To="0.95" Duration="0:0:0.06"/>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                       To="0.95" Duration="0:0:0.06"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleX"
                                       To="1" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="pressScale" Storyboard.TargetProperty="ScaleY"
                                       To="1" Duration="0:0:0.12">
                        <DoubleAnimation.EasingFunction>
                          <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
                <Setter TargetName="bd" Property="BorderThickness" Value="1.5"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                <Setter Property="Opacity" Value="0.5"/>
                <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource GridLine}"/>
                <Setter Property="Cursor" Value="Arrow"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>


    <!-- 一个清理位置的整行（含就地展开的候选文件）。
         2.11：分类行**就地展开**用的就是这一套模板，不再切到「位置页」这个第二视图；
         所以同一个 DataTemplate 是位置行的唯一出处，展开与选择状态都挂在同一批模型实例上。 -->
    <DataTemplate x:Key="LocationRowTemplate">
      <Border Padding="16,8" BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
              AutomationProperties.Name="{Binding DisplayName}">
        <!-- 完整路径不进标题，也不靠展开面板：悬停在名称上看，或右键复制 / 定位 -->
        <Border.ContextMenu>
          <ContextMenu>
            <MenuItem Header="复制完整路径" Click="LocationCopyPath_Click"/>
            <MenuItem Header="在资源管理器中打开" Click="LocationReveal_Click"/>
          </ContextMenu>
        </Border.ContextMenu>
        <StackPanel>
          <!-- ===== 两行式：第一行名称/空间/操作，第二行父路径与统计 =====
               复选框、AI、路径操作、进入箭头各自处理点击，互不触发行导航。 -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="32"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <!-- 重复组的「问一下留哪一份」（只在重复组的保留项那一行出现） -->
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- 只负责选择 -->
            <CheckBox Grid.Column="0" VerticalAlignment="Center" IsThreeState="True"
                      IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                      Click="LayerCheck_Click" ToolTip="{Binding GroupScopeHint}"
                      AutomationProperties.Name="{Binding DisplayName}"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                        Cursor="Hand" MouseLeftButtonUp="LocationRowOpen_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding DisplayName}" FontSize="13.5"
                           Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Path}"/>
                <!-- 有选择时才出现的短标记，没选择就不占位置 -->
                <Border Margin="8,0,0,0" Padding="6,0" CornerRadius="8" VerticalAlignment="Center"
                        Background="{DynamicResource SelectBg}"
                        Visibility="{Binding HasSelectionBadge, Converter={StaticResource BoolToVisible}}">
                  <TextBlock Text="{Binding SelectionBadge}" FontSize="10.5"
                             Foreground="{DynamicResource Accent}"/>
                </Border>
              </StackPanel>
              <!-- 第二行：精简父路径 · 文件数。模型用途/影响在行下瘦提示里，不在这里复述。 -->
              <TextBlock Text="{Binding RowSubText}" Margin="0,3,0,0" FontSize="11"
                         Foreground="{DynamicResource TextDim}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <!-- 空间固定右对齐，窄窗口也不会被挤出 -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                        HorizontalAlignment="Right" MinWidth="92">
              <TextBlock Text="{Binding SizeText}" FontSize="13.5" HorizontalAlignment="Right"
                         Foreground="{DynamicResource Accent}"/>
            </StackPanel>
            <!-- 在资源管理器中打开：文件夹图标，Tooltip 说清动作 -->
            <Button Grid.Column="4" Style="{StaticResource IconButton}" Width="28" Height="28"
                    Margin="0,0,4,0" Click="LocationReveal_Click"
                    ToolTip="在资源管理器中打开"
                    AutomationProperties.Name="在资源管理器中打开">
              <Path Data="{StaticResource IconFolderOpen}" Width="15" Height="15" Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <!-- 就地展开这一处的候选文件：矢量箭头，不换页面 -->
            <Button Grid.Column="6" Style="{StaticResource ChevronButton}"
                    VerticalAlignment="Center" Click="LocationViewFiles_Click"
                    ToolTip="{Binding FilesToggleText}"
                    AutomationProperties.Name="{Binding FilesToggleText}">
              <Path Data="{Binding FilesGlyphKey, Converter={StaticResource IconKey}}"
                    Width="11" Height="11"
                    Stretch="Uniform"
                    Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
          </Grid>
          <!-- ===== 行内展开：这一处的候选文件，**不需要 AI** =====
               点位置行或右侧箭头就地展开；列表用真正的 CleanItem 实例，
               勾选直接写回同一份状态；只在这里看与勾，不能删。 -->
          <StackPanel Margin="32,6,0,2"
                      Visibility="{Binding IsFilesOpen, Converter={StaticResource BoolToVisible}}">
            <DockPanel Margin="0,0,10,2">
              <Button DockPanel.Dock="Right" Style="{StaticResource ChipButton}"
                      Padding="10,3" FontSize="11.5" Margin="10,0,0,0"
                      Content="选择这些文件" Click="AiSelectBucket_Click"
                      ToolTip="只勾选符合本地清理资格的项，之后仍会走清理确认"
                      AutomationProperties.Name="选择这些文件"
                      Visibility="{Binding ShowLocalSelectChip, Converter={StaticResource BoolToVisible}}"/>
              <TextBlock Text="{Binding FilesNote}" FontSize="11"
                         Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                         VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="{Binding FilesToggleText}" Visibility="Collapsed"/>
            <!-- 头部：名称 / 修改时间 / 大小 / 勾选，四列对齐 -->
            <Grid Margin="0,6,10,2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Grid.Column="1" Text="{Binding NameHeaderText}" FontSize="10.5"
                         Foreground="{DynamicResource TextMuted}"/>
              <TextBlock Grid.Column="2" Text="{Binding ModifiedHeaderText}" FontSize="10.5"
                         Margin="0,0,12,0" MinWidth="104" TextAlignment="Right"
                         Foreground="{DynamicResource TextMuted}"/>
              <TextBlock Grid.Column="3" Text="{Binding SizeHeaderText}" FontSize="10.5" MinWidth="80"
                         TextAlignment="Right" Foreground="{DynamicResource TextMuted}"/>
            </Grid>
            <!-- 列表本身**不做嵌套滚动**：最多 30 行，多出来的只报「另有 N 项」。
                 要看真实目录用上面的文件夹图标。行内嵌套滚动条会和外层
                 虚拟化列表抢滚轮，这个坑以前踩过。 -->
            <ItemsControl ItemsSource="{Binding VisibleFiles}" Margin="0,2,10,0">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Height="26">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="26"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- 勾选直接写回 CleanItem.Selected；不可删的项禁用并标「保留」 -->
                    <CheckBox Grid.Column="0" VerticalAlignment="Center"
                              IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              IsEnabled="{Binding CanDelete}"
                              Click="InlineFileCheck_Click"
                              ToolTip="{Binding KeptBadge}"
                              AutomationProperties.Name="{Binding Name}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="11.5"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding FullPath}"
                               Foreground="{DynamicResource Text}"/>
                    <TextBlock Grid.Column="2" Text="{Binding ModifiedText}" FontSize="10.5"
                               Margin="0,0,12,0" MinWidth="104" TextAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}"/>
                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" FontSize="11"
                               MinWidth="80" TextAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource Accent}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </StackPanel>
      </Border>
    </DataTemplate>

    <Style x:Key="TermScrollThumb" TargetType="Thumb">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="bd" Background="{DynamicResource BorderStrong}" CornerRadius="3" Margin="1.5"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TextMuted}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource TextMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <ControlTemplate x:Key="TermVerticalScrollBar" TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track" IsDirectionReversed="True">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource TermScrollThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <ControlTemplate x:Key="TermHorizontalScrollBar" TargetType="ScrollBar">
      <Grid Background="Transparent">
        <Track x:Name="PART_Track">
          <Track.DecreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False"/>
          </Track.DecreaseRepeatButton>
          <Track.Thumb>
            <Thumb Style="{StaticResource TermScrollThumb}"/>
          </Track.Thumb>
          <Track.IncreaseRepeatButton>
            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False"/>
          </Track.IncreaseRepeatButton>
        </Track>
      </Grid>
    </ControlTemplate>
    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="{DynamicResource BorderStrong}"/>
      <Setter Property="Width" Value="8"/>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Vertical">
          <Setter Property="Width" Value="8"/>
          <Setter Property="MinWidth" Value="8"/>
          <Setter Property="Template" Value="{StaticResource TermVerticalScrollBar}"/>
        </Trigger>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Height" Value="8"/>
          <Setter Property="MinHeight" Value="8"/>
          <Setter Property="Template" Value="{StaticResource TermHorizontalScrollBar}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="ScrollViewer">
      <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="ContextMenu">
      <Setter Property="Background" Value="{DynamicResource PanelRight}"/>
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="HasDropShadow" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ContextMenu">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="0,4">
              <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="MenuLine" TargetType="MenuItem">
      <Setter Property="IsEnabled" Value="False"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border Height="1" Margin="10,6" Background="{DynamicResource Border}"/>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="{DynamicResource Text}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="FontFamily" Value="{DynamicResource AppFont}"/>
      <Setter Property="Padding" Value="14,8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="MenuItem">
            <Border x:Name="bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
              <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="GridSplitter">
      <Setter Property="Background" Value="{DynamicResource Border}"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="VerticalAlignment" Value="Stretch"/>
      <Setter Property="ResizeBehavior" Value="PreviousAndNext"/>
      <Setter Property="ShowsPreview" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="GridSplitter">
            <Border x:Name="bd" Background="{TemplateBinding Background}"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="bd" Property="Background" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid>
  <DockPanel x:Name="AppRootDock">
    <!-- 顶部 2.5px 亮橙无感扫盘激光进度条（替代厚重弹窗/遮挡横幅） -->
    <Grid x:Name="TopScanBeamHost" DockPanel.Dock="Top" Height="2.5" Background="Transparent" ClipToBounds="True">
      <Border x:Name="TopScanBeamBar" HorizontalAlignment="Left" Width="0" Opacity="0"
              Background="{DynamicResource BrandAccent}" CornerRadius="1.25"/>
      <Border x:Name="TopScanBeamSweep" Width="260" HorizontalAlignment="Left" Opacity="0"
              Background="{DynamicResource BrandAccent}" CornerRadius="1.25">
        <Border.RenderTransform>
          <TranslateTransform x:Name="TopScanSweepTranslate" X="-260"/>
        </Border.RenderTransform>
      </Border>
    </Grid>

    <!-- 顶部极简标题栏（38px，与背景融合无重分隔线）：品牌 + 轻量同步胶囊 + AI灯 + 主题切换 + 设置 + 窗口控制 -->
    <Border DockPanel.Dock="Top" Height="38" Background="{DynamicResource Bg}" Padding="16,0,8,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="大扫货" Foreground="{DynamicResource TextDim}" FontSize="12.5"
                     FontWeight="SemiBold" VerticalAlignment="Center"/>
          <TextBlock x:Name="TitleDriveSub" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12"
                     VerticalAlignment="Center"/>
          <ComboBox x:Name="DriveBox" Visibility="Collapsed" Width="76"/>
        </StackPanel>

        <!-- 后台同步轻提示胶囊（超短文案） -->
        <Border x:Name="BgPreloadBanner" Grid.Column="1" Visibility="Collapsed"
                HorizontalAlignment="Center" VerticalAlignment="Center" Padding="10,2.5"
                CornerRadius="12" Background="{DynamicResource BrandAccentSoft}"
                BorderBrush="{DynamicResource BrandAccentSoft}" BorderThickness="1">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <ProgressBar x:Name="BgPreloadProgress" Width="22" Height="3.5"
                         IsIndeterminate="True" Margin="0,0,6,0" VerticalAlignment="Center"
                         Foreground="{DynamicResource BrandAccent}"/>
            <TextBlock x:Name="BgPreloadText" FontSize="10.5" FontWeight="Medium"
                       Foreground="{DynamicResource BrandAccent}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="StopButton" Content="停止" Style="{StaticResource GhostButton}"
                  Padding="10,3" FontSize="11" Margin="0,0,6,0" IsEnabled="False" Visibility="Collapsed"
                  Click="StopButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="AiLampButton" Style="{StaticResource ChipButton}" Margin="0,0,4,0"
                  Padding="9,3" BorderThickness="0" Background="Transparent"
                  Click="AiLamp_Click" AutomationProperties.Name="AI 连接状态"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="AiLampDot" Width="6.5" Height="6.5" Margin="0,0,5,0"
                       VerticalAlignment="Center" Fill="#E07070"/>
              <TextBlock x:Name="AiLampText" FontSize="11" Foreground="{DynamicResource TextMuted}"
                         VerticalAlignment="Center" MaxWidth="136" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
          </Button>
          <Button x:Name="ThemeToggleBtn" Style="{StaticResource IconButton}" Width="30" Height="30"
                  Margin="0,0,2,0" Click="ThemeToggle_Click" ToolTip="切换深浅主题"
                  AutomationProperties.Name="切换主题" WindowChrome.IsHitTestVisibleInChrome="True">
            <Path x:Name="ThemeToggleIcon" Data="{StaticResource IconSun}"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="ThemeToggleScale" ScaleX="1" ScaleY="1"/>
                  <RotateTransform x:Name="ThemeToggleRotate" Angle="0"/>
                </TransformGroup>
              </Path.RenderTransform>
            </Path>
          </Button>
          <Button x:Name="SettingsButton" Style="{StaticResource IconButtonGear}" Width="30" Height="30"
                  Margin="0,0,4,0" Click="SettingsButton_Click"
                  ToolTip="设置" AutomationProperties.Name="打开设置"
                  WindowChrome.IsHitTestVisibleInChrome="True">
            <Button.Triggers>
              <EventTrigger RoutedEvent="MouseEnter">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SettingsGearRotate" Storyboard.TargetProperty="Angle"
                                     To="55" Duration="0:0:0.24">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
              <EventTrigger RoutedEvent="MouseLeave">
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="SettingsGearRotate" Storyboard.TargetProperty="Angle"
                                     To="0" Duration="0:0:0.22">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut"/>
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </EventTrigger>
            </Button.Triggers>
            <Path Data="{StaticResource IconGear}" Fill="{Binding Foreground,
                  RelativeSource={RelativeSource AncestorType=Button}}"
                  Width="14" Height="14" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
              <Path.RenderTransform>
                <RotateTransform x:Name="SettingsGearRotate" Angle="0"/>
              </Path.RenderTransform>
            </Path>
          </Button>
          <Button Content="—" Style="{StaticResource CaptionButton}" Width="32" Height="28" Click="MinButton_Click"/>
          <Button x:Name="MaxButton" Content="□" Style="{StaticResource CaptionButton}" Width="32" Height="28" Click="MaxButton_Click"/>
          <Button Content="×" Style="{StaticResource CaptionCloseButton}" Width="32" Height="28" Click="CloseButton_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="ScanProgressPanel" DockPanel.Dock="Top" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource Border}"
            BorderThickness="0,0,0,1" Padding="20,7" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <ProgressBar x:Name="ScanProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"/>
        <TextBlock x:Name="ScanProgressText" Grid.Column="1" Foreground="{DynamicResource TextDim}" Margin="12,0,0,0"
                   FontSize="11" VerticalAlignment="Center" Text="正在扫描…"/>
      </Grid>
    </Border>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="60"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- ===== 方案 1 左侧 60px 纯图标极简 Dock（零多余文字） ===== -->
      <Border x:Name="NavRailPanel" Grid.Column="0" Background="{DynamicResource PanelLeft}"
              BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0" Padding="8,14">
        <DockPanel>
          <StackPanel DockPanel.Dock="Top" HorizontalAlignment="Center">
            <Grid Margin="0,0,0,8">
              <Border x:Name="TabCleanIndicator" Width="3" Height="20" CornerRadius="1.5"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-8,0,0,0"
                      Background="{DynamicResource BrandAccent}"/>
              <Button x:Name="TabCleanBtn" Style="{StaticResource NavRailTabButton}" Width="42" Height="40"
                      Padding="0" Margin="0" HorizontalContentAlignment="Center"
                      Click="TabClean_Click" ToolTip="清理中心">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource IconDriveOutline}" Width="17" Height="17" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock x:Name="TabCleanText" Text="清理中心" Visibility="Collapsed"/>
                </StackPanel>
              </Button>
            </Grid>
            <Button x:Name="TabOrganizeBtn" Content="文件夹整理" Style="{StaticResource NavRailTabButton}"
                    Click="TabOrganize_Click" Visibility="Collapsed"/>
            <Grid Margin="0,0,0,12">
              <Border x:Name="TabUninstallIndicator" Width="3" Height="20" CornerRadius="1.5"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-8,0,0,0"
                      Background="{DynamicResource BrandAccent}" Visibility="Collapsed"/>
              <Button x:Name="TabUninstallBtn" Style="{StaticResource NavRailTabButton}" Width="42" Height="40"
                      Padding="0" Margin="0" HorizontalContentAlignment="Center"
                      Click="TabUninstall_Click" ToolTip="卸载">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Path Data="{StaticResource IconAppsOutline}" Width="16" Height="16" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  <TextBlock x:Name="TabUninstallText" Text="卸载" Visibility="Collapsed"/>
                </StackPanel>
              </Button>
            </Grid>

            <Border Width="22" Height="1" Background="{DynamicResource BorderStrong}" Margin="0,2,0,12"/>
          </StackPanel>

          <Button x:Name="ScanButton" DockPanel.Dock="Bottom" Style="{StaticResource IconButton}"
                  Width="38" Height="38" HorizontalAlignment="Center" ToolTip="重新扫描"
                  AutomationProperties.Name="扫描" Click="ScanButton_Click">
            <Path Data="{StaticResource IconRefresh}" Width="15" Height="15" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>

          <!-- 极简盘符切片按钮（C: / D:，仅留字母，容量与缓存状态在悬停详情中） -->
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="DriveCardsList" HorizontalAlignment="Center">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Margin="0,0,0,8" Width="40" Height="34" CornerRadius="9" BorderThickness="1"
                          Cursor="Hand" MouseLeftButtonUp="DriveCard_Click"
                          RenderTransformOrigin="0.5,0.5">
                    <Border.ToolTip>
                      <TextBlock>
                        <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding UsageSummary, Mode=OneWay}"/>
                        <LineBreak/>
                        <Run Text="{Binding FreeText, Mode=OneWay}"/>
                        <Run Text=" · "/>
                        <Run Text="{Binding StatusText, Mode=OneWay}"/>
                      </TextBlock>
                    </Border.ToolTip>
                    <Border.RenderTransform>
                      <TransformGroup>
                        <TranslateTransform Y="0"/>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                      </TransformGroup>
                    </Border.RenderTransform>
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Style.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                            <Trigger.EnterActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                   To="-1.5" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction>
                                      <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                  </DoubleAnimation>
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                              <BeginStoryboard>
                                <Storyboard>
                                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(TranslateTransform.Y)"
                                                   To="0" Duration="0:0:0.16">
                                    <DoubleAnimation.EasingFunction>
                                      <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                  </DoubleAnimation>
                                </Storyboard>
                              </BeginStoryboard>
                            </Trigger.ExitActions>
                          </Trigger>
                          <DataTrigger Binding="{Binding IsActive}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource BrandAccentSoft}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <Grid>
                      <TextBlock Text="{Binding DriveLetter}" FontSize="12" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource BrandAccent}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                      <Ellipse Width="4" Height="4" HorizontalAlignment="Right" VerticalAlignment="Top"
                               Margin="0,5,5,0" Fill="{DynamicResource BrandAccent}">
                        <Ellipse.Style>
                          <Style TargetType="Ellipse">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding IsCached}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Ellipse.Style>
                      </Ellipse>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <Border x:Name="RightPanel" Grid.Column="1" Background="{DynamicResource Bg}">
        <Grid>
          <!-- ===== 方案 1：极简纯白/黑曜 × 亮橙空间圆环（去繁就简，图形与数字直接说话） ===== -->
          <DockPanel x:Name="OrganizePane">
            <!-- 隐形状态保留（兼容回归检查与辅助提示，不在主界面堆文字噪点） -->
            <StackPanel Visibility="Collapsed">
              <TextBlock x:Name="VolumeText"/>
              <TextBlock x:Name="OrganizeSub"/>
              <TextBlock x:Name="OrganizeCounts"/>
              <TextBlock x:Name="OrganizeNoteText"/>
              <Border x:Name="FlatModeBadge" Visibility="Collapsed">
                <TextBlock x:Name="FlatModeBadgeText" Text="平铺"/>
              </Border>
            </StackPanel>

            <!-- 状态：未扫描 / 扫描中 / 空结果 / 失败（仅无数据时显示） -->
            <Border x:Name="OrganizeStateBox" DockPanel.Dock="Top" Visibility="Collapsed"
                    Margin="28,16,28,0" CornerRadius="10" Background="{DynamicResource CardSurface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="14,12">
              <StackPanel>
                <TextBlock x:Name="OrganizeStateTitle" Foreground="{DynamicResource Text}" FontSize="13" FontWeight="SemiBold"/>
                <TextBlock x:Name="OrganizeStateBody" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDim}" FontSize="11.5"/>
                <Button x:Name="OrganizeStateBtn" Style="{StaticResource GhostButton}" Margin="0,10,0,0"
                        Padding="12,5" FontSize="11.5" HorizontalAlignment="Left"
                        Visibility="Collapsed" Click="OrganizeStateAction_Click"/>
              </StackPanel>
            </Border>

            <!-- 主双栏内容区 + 按需抽屉式 AI 参谋 -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="288"/>
                <ColumnDefinition Width="1"/>
                <ColumnDefinition Width="*" MinWidth="300"/>
                <ColumnDefinition x:Name="OrganizeReportSplitterCol" Width="0"/>
                <ColumnDefinition x:Name="OrganizeReportCol" Width="0" MinWidth="0" MaxWidth="760"/>
              </Grid.ColumnDefinitions>

              <!-- 左视觉舞台：亮橙分段圆环 + 中心数字 + 清理胶囊按钮 + 四点筛选 -->
              <Grid x:Name="RadialStagePanel" Grid.Column="0" Background="{DynamicResource Bg}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0">

                  <!-- 顶部极简盘信息行 -->
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <TextBlock x:Name="RadialDriveMeta" Text="C:" FontSize="11.5" FontWeight="Medium"
                               Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                    <Button x:Name="OrganizeScanDetailsBtn" Style="{StaticResource IconButton}" Width="22" Height="22"
                            Margin="6,0,0,0" Click="ScanDetails_Click" ToolTip="扫描信息（来源、耗时、跳过项）"
                            AutomationProperties.Name="查看扫描信息">
                      <Path Data="{StaticResource IconInfo}" Width="12" Height="12" Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                  </StackPanel>

                  <!-- 216x216 分段亮橙占比圆环 -->
                  <Grid Width="216" Height="216" HorizontalAlignment="Center">
                    <Canvas x:Name="RadialRingCanvas" Width="216" Height="216" RenderTransformOrigin="0.5,0.5">
                      <Path x:Name="RingArcFree" Stroke="{DynamicResource RingLightGray}" StrokeThickness="24"
                            StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"/>
                      <Path x:Name="RingArcRed" Stroke="{DynamicResource RingMidGray}" StrokeThickness="24"
                            StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                            Cursor="Hand" MouseLeftButtonUp="StorageSegRed_Click" ToolTip="点击筛选：系统/重要"/>
                      <Path x:Name="RingArcYellow" Stroke="{DynamicResource RingCharcoal}" StrokeThickness="24"
                            StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                            Cursor="Hand" MouseLeftButtonUp="StorageSegYellow_Click" ToolTip="点击筛选：大文件"/>
                      <Path x:Name="RingArcOrange" Stroke="{DynamicResource RingOrange}" StrokeThickness="24"
                            StrokeStartLineCap="Flat" StrokeEndLineCap="Flat"
                            Cursor="Hand" MouseLeftButtonUp="StorageSegGreen_Click" ToolTip="点击筛选：可清理"/>
                    </Canvas>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                      <TextBlock x:Name="RadialHeroValue" Text="—" FontSize="29" FontWeight="SemiBold"
                                 HorizontalAlignment="Center" Foreground="{DynamicResource Text}"/>
                      <TextBlock x:Name="RadialHeroCaption" Text="准备就绪" FontSize="11"
                                 HorizontalAlignment="Center" Margin="0,2,0,0"
                                 Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                  </Grid>

                  <!-- 核心亮橙胶囊行动区 -->
                  <Border x:Name="FolderDeleteBarCard" Margin="0,24,0,0" HorizontalAlignment="Center"
                          DataContext="{Binding FolderDelete, RelativeSource={RelativeSource AncestorType=Window}}">
                    <StackPanel HorizontalAlignment="Center">
                      <Button Style="{StaticResource OrangePillButton}" MinWidth="138" Height="38"
                              Content="{Binding DeleteText}" IsEnabled="{Binding CanDelete}"
                              Click="FolderDeletePreview_Click"
                              AutomationProperties.Name="{Binding DeleteText}"
                              ToolTip="{Binding SelectedText}"/>

                      <ProgressBar Height="3.5" Width="120" Margin="0,8,0,0" IsIndeterminate="True"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>

                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                        <Button x:Name="FolderDeleteClearBtn" Style="{StaticResource ChipButton}"
                                Padding="10,4" FontSize="11" Margin="0,0,6,0" Content="清空"
                                Click="FolderDeleteClear_Click"
                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisible}}"/>
                        <Button Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11" Margin="0,0,6,0"
                                Content="{Binding CancelText}" IsEnabled="{Binding CanCancel}"
                                Click="FolderDeleteCancel_Click"
                                AutomationProperties.Name="{Binding CancelText}"
                                Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisible}}"/>
                        <Button x:Name="AiReportBtn" Style="{StaticResource ChipButton}"
                                Background="{DynamicResource BrandAccentSoft}"
                                BorderBrush="{DynamicResource BrandAccentSoft}"
                                Foreground="{DynamicResource BrandAccent}"
                                Padding="11,4" Margin="0,0,6,0" Click="AiReport_Click"
                                AutomationProperties.Name="AI 分析">
                          <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconAi}" Width="11" Height="11" Stretch="Uniform"
                                  Margin="0,0,5,0" VerticalAlignment="Center"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock x:Name="AiReportBtnText" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Button>
                        <Button x:Name="AiReportToggleBtn" Style="{StaticResource ChipButton}"
                                Padding="10,4" FontSize="11"
                                Visibility="Visible" Click="AiReportToggle_Click"
                                AutomationProperties.Name="展开或收起 AI 分析面板"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>

                  <!-- 极简 4 胶囊快捷筛选（数字全部收纳到悬停 Tooltip） -->
                  <Border Margin="0,20,0,0" CornerRadius="10" Background="{DynamicResource PanelLeft}"
                          BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="3"
                          HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Button x:Name="ColorFilterAllBtn" Style="{StaticResource ChipButton}"
                              Padding="9,3.5" Margin="0,0,2,0" FontSize="11"
                              Content="全部" Click="ColorFilterAll_Click"/>
                      <Button x:Name="ColorFilterGreenBtn" Style="{StaticResource ChipButton}"
                              Padding="9,3.5" Margin="0,0,2,0" FontSize="11"
                              Click="ColorFilterGreen_Click">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ToneGreenAccent}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="ColorFilterGreenText" Text="可清" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="ColorFilterYellowBtn" Style="{StaticResource ChipButton}"
                              Padding="9,3.5" Margin="0,0,2,0" FontSize="11"
                              Click="ColorFilterYellow_Click">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ToneYellowAccent}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="ColorFilterYellowText" Text="大文件" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                      <Button x:Name="ColorFilterRedBtn" Style="{StaticResource ChipButton}"
                              Padding="9,3.5" FontSize="11"
                              Click="ColorFilterRed_Click">
                        <StackPanel Orientation="Horizontal">
                          <Ellipse Width="6" Height="6" Fill="{DynamicResource ToneRedAccent}" Margin="0,0,4,0" VerticalAlignment="Center"/>
                          <TextBlock x:Name="ColorFilterRedText" Text="系统" VerticalAlignment="Center"/>
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>

              <!-- 1px 瑞士极细垂直分界线 -->
              <Border Grid.Column="1" Width="1" Margin="0,30,0,30" Background="{DynamicResource Border}"/>

              <!-- 右侧极净文件夹清单：圆框 + 极简线性图标 + 文件夹名 + 比例横条 + 容量数字（零多余文字） -->
              <Border x:Name="OrganizeGridHost" Grid.Column="2" Padding="18,14,22,12" Background="{DynamicResource Bg}">
                <DataGrid x:Name="OrganizeGrid" AutoGenerateColumns="False" CanUserSortColumns="False"
                          HeadersVisibility="None" GridLinesVisibility="Horizontal"
                          BorderThickness="0" RowHeight="NaN" MinRowHeight="46" Margin="0"
                          RowBackground="{DynamicResource Bg}" Background="{DynamicResource Bg}"
                          HorizontalGridLinesBrush="{DynamicResource GridLine}" EnableRowVirtualization="True"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          VerticalContentAlignment="Center"
                          HorizontalScrollBarVisibility="Disabled"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.CacheLength="1,1"
                          VirtualizingPanel.CacheLengthUnit="Page"
                          ScrollViewer.CanContentScroll="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          SelectionChanged="OrganizeGrid_SelectionChanged"
                          MouseDoubleClick="OrganizeGrid_MouseDoubleClick"
                          PreviewMouseRightButtonDown="OrganizeGrid_PreviewRightDown">
                  <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                      <Setter Property="Background" Value="{DynamicResource Bg}"/>
                      <Setter Property="BorderBrush" Value="Transparent"/>
                      <Setter Property="BorderThickness" Value="0"/>
                      <Style.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter Property="Background" Value="{DynamicResource HoverBg}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                          <Setter Property="Background" Value="{DynamicResource SelectBg}"/>
                          <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding IsJumpHighlighted}" Value="True">
                          <Setter Property="Background" Value="{DynamicResource JumpHighlightBg}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGrid.RowStyle>
                  <DataGrid.ContextMenu>
                    <ContextMenu Opened="OrganizeMenu_Opened">
                      <MenuItem x:Name="OrgCtxOpen" Header="在资源管理器中打开" Click="OrganizeOpen_Click"/>
                      <MenuItem x:Name="OrgCtxCopy" Header="复制完整路径" Click="OrganizeCopyPath_Click"/>
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <DataGridTemplateColumn Width="34" MinWidth="34" CanUserResize="False" CanUserSort="False"
                                            IsReadOnly="True">
                      <DataGridTemplateColumn.Header>
                        <TextBlock Text=""/>
                      </DataGridTemplateColumn.Header>
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <CheckBox VerticalAlignment="Center" HorizontalAlignment="Center"
                                    IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding IsSelectionProtected, Converter={StaticResource InvertBool}}"
                                    Click="OrganizeSelect_Click"
                                    ToolTip="{Binding SelectionNote}"
                                    AutomationProperties.Name="{Binding SelectionNote}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 名称：缩进 + 展开箭头 + 极简线性文件夹图标 + 文件夹名（路径悬停可见） -->
                    <DataGridTemplateColumn x:Name="ColOrgName" Header="名称" Width="1.8*" MinWidth="180"
                                            CanUserResize="True" CanUserSort="False" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid VerticalAlignment="Stretch" Margin="0,6,6,6">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="3" CornerRadius="1.5" Margin="0,2,4,2">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="Transparent"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsJumpHighlighted}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource BrandAccent}"/>
                                      <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="jumpPulse">
                                          <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                             From="1" To="0.32" Duration="0:0:0.42"
                                                             AutoReverse="True" RepeatBehavior="3x"/>
                                          </Storyboard>
                                        </BeginStoryboard>
                                      </DataTrigger.EnterActions>
                                      <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="jumpPulse"/>
                                      </DataTrigger.ExitActions>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                            </Border>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                              <Border Width="{Binding IndentWidth}" Height="1"/>
                              <Button Style="{StaticResource IconButton}" Width="20" Height="20" Padding="0"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Visibility="{Binding CanExpand, Converter={StaticResource BoolToVisible}}"
                                      Click="OrganizeExpand_Click" ToolTip="{Binding ExpandTip}"
                                      AutomationProperties.Name="{Binding ExpandTip}">
                                <Path Data="{Binding ExpandGlyphKey, Converter={StaticResource IconKey}}"
                                      Width="9" Height="9" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              </Button>
                              <Button Style="{StaticResource IconButton}" Width="20" Height="20" Padding="0"
                                      VerticalAlignment="Center" Margin="0,0,4,0"
                                      Visibility="{Binding CanViewFiles, Converter={StaticResource BoolToVisible}}"
                                      Click="OrganizeFiles_Click" ToolTip="{Binding FilesToggleText}"
                                      AutomationProperties.Name="{Binding FilesToggleText}">
                                <Path Data="{StaticResource IconFileLines}" Width="11" Height="11" Stretch="Uniform"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                              </Button>
                              <Path Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0" VerticalAlignment="Center">
                                <Path.Style>
                                  <Style TargetType="Path">
                                    <Setter Property="Data" Value="{StaticResource IconFolderOutline}"/>
                                    <Setter Property="Fill" Value="{DynamicResource TextDim}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding IsDirectoryNode}" Value="False">
                                        <Setter Property="Data" Value="{StaticResource IconFileLines}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding ColorToneKey}" Value="Green">
                                        <Setter Property="Fill" Value="{DynamicResource BrandAccent}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding ColorToneKey}" Value="Red">
                                        <Setter Property="Data" Value="{StaticResource IconShield}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Path.Style>
                              </Path>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}" Foreground="{DynamicResource Text}" FontSize="13.5"
                                           FontWeight="Medium" TextTrimming="CharacterEllipsis" MaxWidth="320"
                                           ToolTip="{Binding FullPath}"/>
                                <Border MaxWidth="0" MaxHeight="0" Opacity="0" IsHitTestVisible="False"
                                        Visibility="{Binding IsSystemEntry, Converter={StaticResource BoolToVisible}}">
                                  <TextBlock Text="{Binding SystemEntryTag}" FontSize="10"/>
                                </Border>
                                <Border MaxWidth="0" MaxHeight="0" Opacity="0" IsHitTestVisible="False"
                                        Visibility="{Binding IsPlatformContainer, Converter={StaticResource BoolToVisible}}">
                                  <TextBlock Text="{Binding PlatformTag}" FontSize="10"/>
                                </Border>
                                <Border MaxWidth="0" MaxHeight="0" Opacity="0" IsHitTestVisible="False"
                                        Visibility="{Binding IsCoveredByAncestor, Converter={StaticResource BoolToVisible}}">
                                  <TextBlock Text="{Binding CoveredTag}" FontSize="10"/>
                                </Border>
                                <TextBlock Text="{Binding RelativePath}" FontSize="10.5"
                                           FontFamily="{DynamicResource MonoFont}"
                                           Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" MaxWidth="320"
                                           ToolTip="{Binding FullPath}"
                                           Visibility="{Binding ShowPathHint, Converter={StaticResource BoolToVisible}}"/>
                              </StackPanel>
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 用途：默认只呈现一根干净的亮橙/灰比例横条；点击这一格按需展开说明与文件 -->
                    <DataGridTemplateColumn x:Name="ColOrgPurpose" Header="用途" Width="1.1*" MinWidth="136"
                                            CanUserResize="True" CanUserSort="False" IsReadOnly="True">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center" Margin="0,6,8,6" Background="Transparent"
                                      Cursor="Hand" ToolTip="{Binding DisplayPurposeTip}"
                                      MouseLeftButtonUp="OrganizePurpose_Click">
                            <Border Height="5" Width="124" HorizontalAlignment="Left" CornerRadius="2.5"
                                    Background="{DynamicResource BarTrack}">
                              <Border HorizontalAlignment="Left" Height="5" CornerRadius="2.5"
                                      Width="{Binding SizeBarWidth}">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource RingMidGray}"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding ColorToneKey}" Value="Green">
                                        <Setter Property="Background" Value="{DynamicResource BrandAccent}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding ColorToneKey}" Value="Yellow">
                                        <Setter Property="Background" Value="{DynamicResource RingCharcoal}"/>
                                      </DataTrigger>
                                      <DataTrigger Binding="{Binding ColorToneKey}" Value="Red">
                                        <Setter Property="Background" Value="{DynamicResource RingMidGray}"/>
                                      </DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                              </Border>
                            </Border>
                            <TextBlock Text="{Binding DisplayPurposeLine}" Visibility="Collapsed"/>
                            <TextBlock Text="{Binding PurposeDetail}" Visibility="Collapsed"/>
                            <TextBlock Text="{Binding AiSummaryText}" Visibility="Collapsed"/>
                            <Border Margin="0,8,0,2" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    Visibility="{Binding IsDetailOpen, Converter={StaticResource BoolToVisible}}">
                              <TextBlock Text="{Binding DetailText}" FontSize="11" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextDim}"/>
                            </Border>
                            <Border Margin="0,8,0,2" Padding="10,8" CornerRadius="8"
                                    Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                                    Visibility="{Binding IsFilesOpen, Converter={StaticResource BoolToVisible}}">
                              <StackPanel>
                                <TextBlock Text="{Binding FilesNote}" FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextDim}"/>
                                <ItemsControl ItemsSource="{Binding VisibleFiles}" Margin="0,4,0,0">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                      <Grid Height="22">
                                        <Grid.ColumnDefinitions>
                                          <ColumnDefinition Width="*"/>
                                          <ColumnDefinition Width="Auto"/>
                                          <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Name}" FontSize="11"
                                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Hint}"
                                                   Foreground="{DynamicResource Text}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding ModifiedText}" FontSize="10"
                                                   Margin="0,0,10,0" MinWidth="98" TextAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMuted}"/>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" FontSize="10.5"
                                                   MinWidth="70" TextAlignment="Right" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource AccentDim}"/>
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                              </StackPanel>
                            </Border>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- 容量：简洁右对齐加粗大数字 -->
                    <DataGridTemplateColumn x:Name="ColOrgSize" Header="容量" SortMemberPath="Size"
                                            Width="98" MinWidth="92" CanUserResize="False" IsReadOnly="True"
                                            HeaderStyle="{StaticResource OrganizeSizeHeader}"
                                            CellStyle="{StaticResource OrganizeSizeCell}">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center" Margin="0,4,6,4">
                            <TextBlock Text="{Binding SizeText}" FontSize="13.5" FontWeight="SemiBold"
                                       TextAlignment="Right" Foreground="{DynamicResource Text}"
                                       ToolTip="{Binding ContentStateTip}"/>
                            <TextBlock Text="{Binding ContentStateText}" FontSize="10" Margin="0,2,0,0"
                                       TextAlignment="Right" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMuted}"
                                       ToolTip="{Binding ContentStateTip}"
                                       Visibility="{Binding HasContentState,
                                                    Converter={StaticResource BoolToVisible}}"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </Border>

              <!-- 可左右拖动的透明分隔条（按需打开 AI 报告时才出现） -->
              <GridSplitter x:Name="OrganizeReportSplitter" Grid.Column="3" Width="8" Visibility="Collapsed"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                            Background="Transparent" ShowsPreview="False"
                            Cursor="SizeWE" ToolTip="左右拖动可拉宽或收窄 AI 面板"/>

              <!-- 按需展开的右侧 AI 参谋抽屉（默认收起，保持方案 1 极净双栏） -->
              <Border x:Name="OrganizeReportPanel" Grid.Column="4" Visibility="Collapsed"
                      Margin="0,10,16,12" CornerRadius="10" Background="{DynamicResource PanelLeft}"
                      BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
                <DockPanel>
                  <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                          Padding="14,10">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="20" Height="20" CornerRadius="6" Margin="0,0,7,0"
                                Background="{DynamicResource BrandAccentSoft}">
                          <Path Data="{StaticResource IconAi}" Width="11" Height="11" Stretch="Uniform"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Fill="{DynamicResource BrandAccent}"/>
                        </Border>
                        <TextBlock x:Name="OrganizeReportHeaderTitle" Text="AI 建议"
                                   FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Text}"
                                   VerticalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="OrganizeReportExpandBtn" Style="{StaticResource GhostButton}"
                                Padding="8,3" FontSize="11" Margin="0,0,6,0"
                                Visibility="Collapsed"
                                Content="大窗查看" Click="OrganizeReportExpand_Click"
                                AutomationProperties.Name="在大窗口中查看 AI 分析报告"/>
                        <Button x:Name="OrganizeReportCloseBtn" Style="{StaticResource IconButton}"
                                Width="26" Height="26" Padding="0" Click="OrganizeReportClose_Click"
                                ToolTip="收起" AutomationProperties.Name="收起报告面板">
                          <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                      </StackPanel>
                    </Grid>
                  </Border>
                  <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,12">
                    <StackPanel x:Name="OrganizeReportContent"/>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </Grid>
          </DockPanel>
          <DockPanel x:Name="CleanPane" Visibility="Collapsed">
            <StackPanel x:Name="CleanProgressPanel" DockPanel.Dock="Top" Margin="20,12,20,10" Visibility="Collapsed">
              <TextBlock x:Name="CleanProgressText" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,6"/>
              <ProgressBar x:Name="CleanProgressBar" Height="8" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <!-- ===== 页头：页面标题 + 返回 + 简短扫描状态 ===== -->
            <Border DockPanel.Dock="Top" Background="{DynamicResource PanelLeft}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"
                    Padding="18,12,18,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- 返回：**只有一个箭头按钮**。当前页面标题在右边单独显示，
                     不再「面包屑 + 大标题」并排重复同一句话。 -->
                <Button x:Name="CleanBackBtn" Grid.Column="0" Style="{StaticResource IconButton}"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="CleanBack_Click"
                        ToolTip="返回清理中心"
                        AutomationProperties.Name="返回清理中心">
                  <Path Data="{StaticResource IconBack}" Width="15" Height="15" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
                <!-- 标题 + 统计两行：标题只出现一次；统计用「候选空间」而不是「预计处理」。 -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                  <TextBlock x:Name="CleanPageTitle" Foreground="{DynamicResource Text}"
                             FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                  <TextBlock x:Name="CleanPageSub" Margin="0,2,0,0"
                             Foreground="{DynamicResource TextDim}" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
                  <!-- 只有异常（部分内容未检测 / 取消 / 失败）才出现的短警告入口；
                       成功扫描不再反复显示，操作状态也并入这一行。 -->
                  <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock x:Name="HeaderStats" Foreground="{DynamicResource TextDim}" FontSize="11"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="  ·  " Foreground="{DynamicResource TextMuted}" FontSize="11"
                               Visibility="{Binding Text, ElementName=HeaderStats,
                                            Converter={StaticResource EmptyToCollapsed}}"/>
                    <TextBlock x:Name="CleanScanState" TextWrapping="Wrap"
                               Foreground="{DynamicResource Accent}" FontSize="11"/>
                  </StackPanel>
                </StackPanel>
                <WrapPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- 这里**没有** AI 分析入口：AI 建议只服务「按文件夹删除」页，
                       报告里的建议也只会定位到那边的文件夹行。 -->
                  <!-- 扫描详情 / 更多：辅助操作用图标按钮，语义靠 ToolTip + 可访问名称 -->
                  <Button x:Name="ScanDetailsBtn" Style="{StaticResource IconButton}" Margin="0,0,4,0"
                          Click="ScanDetails_Click" ToolTip="扫描信息（来源、权限、耗时、跳过项）"
                          AutomationProperties.Name="查看扫描信息">
                    <Path Data="{StaticResource IconInfo}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </Button>
                  <Button x:Name="CleanMoreBtn" Style="{StaticResource IconButton}" Click="CleanMore_Click"
                          ToolTip="更多" AutomationProperties.Name="更多操作">
                    <Path Data="{StaticResource IconMore}" Width="16" Height="16" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                  </Button>
                </WrapPanel>
              </Grid>
            </Border>

            <!-- 清理范围提示：只有用户显式执行「只看此文件夹的清理项」后才出现 -->
            <Border x:Name="CleanScopeBar" DockPanel.Dock="Top" Visibility="Collapsed"
                    Background="{DynamicResource PanelRight}" Padding="16,6">
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="CleanScopeText" Foreground="{DynamicResource Accent}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <Button x:Name="ClearScopeBtn" Style="{StaticResource GhostButton}" Margin="10,0,0,0"
                        Padding="6,2" FontSize="11" Click="ClearScope_Click"
                        AutomationProperties.Name="清除清理范围"/>
              </StackPanel>
            </Border>

            <!-- 第三层补充：一次性提示（AI 状态、重复检测进度、删除结果等） -->
            <TextBlock x:Name="CleanSummarySub" DockPanel.Dock="Top" Margin="16,6,16,0"
                       Foreground="{DynamicResource TextDim}" FontSize="11" TextWrapping="Wrap"/>


            <!-- 状态提示区：空 / 进行中 / 部分完成 / 取消 / 失败 -->
            <Border x:Name="CleanStateBox" DockPanel.Dock="Top" Visibility="Collapsed"
                    Background="{DynamicResource PanelRight}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,0,0,1" Padding="16,10">
              <StackPanel>
                <TextBlock x:Name="CleanStateTitle" Foreground="{DynamicResource Text}" FontSize="13"/>
                <TextBlock x:Name="CleanStateBody" Margin="0,3,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextDim}" FontSize="11.5"/>
              </StackPanel>
            </Border>

            <!-- ===== 底部唯一操作栏：选择范围 + 执行入口 ===== -->
            <Border x:Name="CleanActionBar" DockPanel.Dock="Bottom"
                    Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="0,1,0,0" Padding="18,12">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                  <!-- 主行：已选位置数 + 预计处理空间（最突出） -->
                  <TextBlock x:Name="CleanSelectionSummary" Foreground="{DynamicResource Text}"
                             FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                  <!-- 次行：候选项数（含目录时称「项」）+「查看已选」清单按钮 -->
                  <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                    <!-- 有明确按钮外观：清单图标 + 已选数量；未选时禁用 -->
                    <Button x:Name="ViewSelectedBtn" Style="{StaticResource ChipButton}"
                            Click="ViewSelected_Click" ToolTip="查看已选（打开清单，不会清空选择）"
                            AutomationProperties.Name="查看已选">
                      <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconChecklist}" Width="13" Height="13"
                              Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"
                              Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock x:Name="ViewSelectedText" VerticalAlignment="Center" FontSize="11.5"/>
                        <TextBlock x:Name="ViewSelectedCount" VerticalAlignment="Center" FontSize="11.5"
                                   Margin="0,0,0,0" Foreground="{DynamicResource TextMuted}"/>
                      </StackPanel>
                    </Button>
                    <TextBlock x:Name="CleanSelectionNote" Foreground="{DynamicResource TextMuted}"
                               FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0"
                               TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                  <!-- 「全选」是**单个切换按钮**，文字恒为「全选」，两种状态只换外观：
                       - 未全选（含部分选中 / 一个没勾）：幽灵按钮，点一下把**全局**所有
                         可清理项勾上（和旧「清空选择」同一范围，不是当前页）；
                       - 已全选：改用主按钮外观表示「再点一下 = 取消全部勾选」。
                       XAML 里默认是幽灵态；主按钮态由代码在运行时切换（见 ApplySelectAllButton）。 -->
                  <Button x:Name="CleanSelectAllBtn" Content="全选"
                          Style="{StaticResource GhostButton}" Padding="12,6" FontSize="12"
                          Margin="0,0,8,0" Click="CleanSelectAll_Click"
                          ToolTip="全选所有可清理项（再点一次取消全选）"/>
                  <!-- 唯一的主要执行入口。点它进入「清理前检查」页，**不是直接删**。 -->
                  <Button x:Name="CheckAndCleanBtn" Content="清理已选项目" Style="{StaticResource PrimaryButton}"
                          Padding="16,7" FontSize="12.5" Click="CheckAndClean_Click"
                          ToolTip="先做清理前检查，确认后才执行"/>
                </StackPanel>
              </Grid>
            </Border>

            <!-- ===== 主内容区：一次只显示一层（用途页 / 位置页），文件明细是右侧面板 ===== -->
            <Grid x:Name="CleanMain">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="MainCol" Width="*"/>
                <ColumnDefinition x:Name="DetailCol" Width="0"/>
              </Grid.ColumnDefinitions>

              <!-- ==== 第 1 层：清理首页（只显示用途汇总） ==== -->
              <ScrollViewer x:Name="PurposePage" Grid.Column="0" VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled" Padding="0,4,0,8">
                <ItemsControl x:Name="PurposeSections">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <!-- 两个风险分区是**真正独立的两块区域**：左侧色带 + 不同背景层级 +
                           上下留白 + 图标 + 副标题。颜色克制，且不单靠颜色区分（有 ✓ / ! 与文字）。 -->
                      <Border Margin="12,0,12,12" CornerRadius="4" BorderThickness="3,0,0,0">
                        <Border.Style>
                          <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource SectionSafeSurface}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource SectionSafeAccent}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding RiskTier}" Value="1">
                                <Setter Property="Background" Value="{DynamicResource SectionConfirmSurface}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource SectionConfirmAccent}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Border.Style>
                        <StackPanel>
                        <!-- 分区标题：左图标+标题+副标题 / 右统计。
                             点整行都能展开收起；「需要你确认」默认折叠。 -->
                        <Button Style="{StaticResource SectionHeaderButton}" Click="SectionToggle_Click"
                                ToolTip="{Binding HeaderAccessibleName}"
                                AutomationProperties.Name="{Binding HeaderAccessibleName}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <!-- 标题列给最小宽度：窄窗口下先让右侧统计截断，
                                   而不是把中文/英文标题挤成零宽。 -->
                              <ColumnDefinition Width="*" MinWidth="132"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 图标：✓ / ! —— 形状本身也能读出状态 -->
                            <TextBlock Grid.Column="0" FontSize="14" FontWeight="Bold" Width="18"
                                       VerticalAlignment="Top" Margin="0,1,6,0"
                                       Text="{Binding Icon}">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource SectionSafeAccent}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding RiskTier}" Value="1">
                                      <Setter Property="Foreground" Value="{DynamicResource SectionConfirmAccent}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                              <StackPanel Orientation="Horizontal">
                                <!-- 展开/收起用统一的矢量箭头，不再用 ▾ / ▸ 这类字符 -->
                                <Path x:Name="SectionChevronDown" Data="{StaticResource IconChevronDown}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,1,6,0" Fill="{DynamicResource TextMuted}"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}"/>
                                <Path x:Name="SectionChevronRight" Data="{StaticResource IconChevronRight}"
                                      Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center"
                                      Margin="0,1,6,0" Fill="{DynamicResource TextMuted}">
                                  <Path.Style>
                                    <Style TargetType="Path">
                                      <Setter Property="Visibility" Value="Collapsed"/>
                                      <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                                          <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                      </Style.Triggers>
                                    </Style>
                                  </Path.Style>
                                </Path>
                                <TextBlock FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Text}" Text="{Binding HeaderTitle}"/>
                              </StackPanel>
                              <!-- 副标题：说清这一组的性质，不只靠颜色 -->
                              <TextBlock FontSize="11" Margin="18,2,0,0" TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextDim}" Text="{Binding Subtitle}"/>
                              <!-- 折叠组里有已选项时必须说明，否则用户不知道选了什么 -->
                              <TextBlock FontSize="11" Margin="18,2,0,0" TextWrapping="Wrap"
                                         Foreground="{DynamicResource Text}"
                                         Text="{Binding CollapsedSelectionNote}"
                                         Visibility="{Binding HasCollapsedSelection,
                                                      Converter={StaticResource BoolToVisible}}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="2" FontSize="11.5" VerticalAlignment="Center"
                                       HorizontalAlignment="Right" TextTrimming="CharacterEllipsis"
                                       MaxWidth="236" ToolTip="{Binding HeaderStats}"
                                       Foreground="{DynamicResource TextMuted}" Text="{Binding HeaderStats}"/>
                          </Grid>
                        </Button>
                        <!-- 行只在分区展开时渲染：折叠的分区不创建行模型。
                            标题与行之间留出空隙，标题/内容的边界更清楚（不叠卡片）。 -->
                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,4,0,4"
                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <!-- 行高约 64 DIP；名称/箭头就地展开位置，复选框只负责选择。
                                   空白处点击不改变选择，避免误选。 -->
                              <Border MinHeight="64" Padding="16,8" Margin="12,0,16,1"
                                      BorderBrush="{DynamicResource GridLine}" BorderThickness="0,0,0,1"
                                      Background="Transparent"
                                      AutomationProperties.Name="{Binding PurposeName}">
                                <StackPanel>
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="22"/>
                                  </Grid.ColumnDefinitions>
                                  <!-- 勾选只改选择，不导航；悬停说明这是整组范围 -->
                                  <CheckBox Grid.Column="0" VerticalAlignment="Center" IsThreeState="True"
                                            IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Click="LayerCheck_Click" ToolTip="{Binding GroupScopeHint}"
                                            AutomationProperties.Name="{Binding PurposeName}"/>
                                  <!-- 名称可点：**就地展开这一类的清理位置**，不换视图 -->
                                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                                              Cursor="Hand" MouseLeftButtonUp="PurposeExpandRow_Click"
                                              AutomationProperties.Name="{Binding PurposeName}">
                                    <TextBlock Text="{Binding PurposeName}" FontSize="14"
                                               Foreground="{DynamicResource Text}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding PurposeName}"/>
                                    <!-- 清理影响常驻；用 TextDim 保证可读，不用最灰的色 -->
                                    <TextBlock Text="{Binding Impact}" Margin="0,3,0,0" FontSize="11.5"
                                               Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"/>
                                  </StackPanel>
                                  <!-- 右侧信息形成稳定列：数字右对齐 -->
                                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0"
                                              HorizontalAlignment="Right" MinWidth="96">
                                    <TextBlock Text="{Binding SizeText}" FontSize="14"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                    <TextBlock Text="{Binding RowLocationText}" Margin="0,3,0,0" FontSize="11"
                                               Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right"/>
                                  </StackPanel>
                                  <!-- 展开箭头：就地展开，不换页面（图标本身读出展开/收起） -->
                                  <Button Grid.Column="3" Style="{StaticResource ChevronButton}"
                                          VerticalAlignment="Center" Click="PurposeExpand_Click"
                                          ToolTip="{Binding ExpandTip}"
                                          AutomationProperties.Name="{Binding ExpandTip}">
                                    <Path Width="11" Height="11" Stretch="Uniform"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                      <Path.Style>
                                        <Style TargetType="Path">
                                          <Setter Property="Data" Value="{StaticResource IconChevronRight}"/>
                                          <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                              <Setter Property="Data" Value="{StaticResource IconChevronDown}"/>
                                            </DataTrigger>
                                          </Style.Triggers>
                                        </Style>
                                      </Path.Style>
                                    </Path>
                                  </Button>
                                </Grid>
                                <!-- ===== 就地展开：这一类的清理位置 =====
                                     用真正的位置模型实例渲染（同一份勾选状态），
                                     位置行自己再往下就地展开候选文件。不跳视图、不丢选择。 -->
                                <StackPanel Margin="32,6,10,4"
                                            Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVisible}}">
                                  <TextBlock Text="{Binding LocationsNotShownText}" FontSize="10.5"
                                             Margin="0,0,0,4" TextWrapping="Wrap"
                                             Foreground="{DynamicResource TextMuted}"
                                             Visibility="{Binding HasHiddenLocations,
                                                          Converter={StaticResource BoolToVisible}}"/>
                                  <ItemsControl ItemsSource="{Binding VisibleLocations}"
                                                ItemTemplate="{StaticResource LocationRowTemplate}"/>
                                </StackPanel>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>

              <!-- ==== 清理前检查页：主按钮点进来的地方，**还没有删任何东西** ==== -->
              <ScrollViewer x:Name="PreflightPage" Grid.Column="0" Visibility="Collapsed"
                            VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                            Padding="20,10,20,12">
                <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                  <TextBlock x:Name="PreflightTitle" FontSize="15" FontWeight="SemiBold"
                             Foreground="{DynamicResource Text}"/>
                  <TextBlock x:Name="PreflightSub" Margin="0,4,0,0" FontSize="11.5" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextDim}"/>
                  <!-- 将处理的范围：位置数 / 候选项数 / 预计空间 / 需确认数 -->
                  <StackPanel x:Name="PreflightFacts" Margin="0,12,0,0"/>
                  <!-- 程序会再检查一遍什么 -->
                  <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="4"
                          Background="{DynamicResource PanelRight}"
                          BorderBrush="{DynamicResource Border}" BorderThickness="1">
                    <TextBlock x:Name="PreflightRecheck" FontSize="11.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextDim}"/>
                  </Border>
                  <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button x:Name="PreflightBackBtn" Style="{StaticResource GhostButton}"
                            Padding="14,7" FontSize="12.5" Margin="0,0,10,0"
                            Click="PreflightBack_Click"/>
                    <Button x:Name="PreflightConfirmBtn" Style="{StaticResource PrimaryButton}"
                            Padding="18,8" FontSize="12.5" Click="PreflightConfirm_Click"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>

              <!-- 2.11：原先的「位置页」（替换主内容的第二视图）已移除：
                   分类 → 位置 → 文件 全部就地展开，滚动与勾选都不离开这一屏。 -->
              <!-- ==== 文件详情：右侧面板（窄窗口时占满主区域） ==== -->
              <Border x:Name="DetailPanel" Grid.Column="1" Visibility="Collapsed"
                      Background="{DynamicResource PanelRight}"
                      BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <DockPanel>
                  <DockPanel DockPanel.Dock="Top" Margin="14,12,12,8" LastChildFill="True">
                    <Button x:Name="DetailCloseBtn" DockPanel.Dock="Right" Content="关闭" Style="{StaticResource GhostButton}"
                            Padding="8,3" FontSize="11" Click="DetailClose_Click"
                            AutomationProperties.Name="关闭文件明细"/>
                    <StackPanel>
                      <TextBlock x:Name="DetailTitle" Foreground="{DynamicResource Text}" FontSize="14"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="DetailSubtitle" Margin="0,3,0,0" Foreground="{DynamicResource TextDim}"
                                 FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                  </DockPanel>
                  <!-- 在资源管理器中打开 / 复制路径：统一成图标，Tooltip 与可访问名称说清动作 -->
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,0,12,8">
                    <Button x:Name="DetailRevealBtn" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Margin="0,0,6,0" Click="DetailReveal_Click"
                            ToolTip="在资源管理器中打开" AutomationProperties.Name="在资源管理器中打开">
                      <Path Data="{StaticResource IconFolderOpen}" Width="15" Height="15" Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                    <Button x:Name="DetailCopyPathBtn" Style="{StaticResource IconButton}" Width="28" Height="28"
                            Click="DetailCopyPath_Click"
                            ToolTip="复制完整路径" AutomationProperties.Name="复制完整路径">
                      <Path Data="{StaticResource IconCopy}" Width="13" Height="13" Stretch="Uniform"
                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Button>
                  </StackPanel>
                  <TextBox x:Name="DetailPathBox" DockPanel.Dock="Top" Visibility="Collapsed" Margin="14,0,12,8"
                           IsReadOnly="True" BorderBrush="{DynamicResource Border}" BorderThickness="1"
                           Background="{DynamicResource PanelLeft}" Foreground="{DynamicResource Text}"
                           FontFamily="{DynamicResource MonoFont}" FontSize="11" TextWrapping="Wrap"/>
                  <DockPanel DockPanel.Dock="Top" Margin="14,0,12,8" LastChildFill="True">
                    <TextBlock x:Name="DetailCountHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{DynamicResource TextDim}" FontSize="11"/>
                    <TextBox x:Name="DetailSearchBox" Style="{StaticResource TermTextBox}" Height="26"
                             HorizontalAlignment="Left" Tag="搜索文件名 / 路径"
                             TextChanged="DetailSearch_TextChanged"/>
                  </DockPanel>
                  <!-- 选择范围：区分当前页 / 搜索结果 / 整组；范围写进文案 -->
                  <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="14,0,12,8">
                    <Button x:Name="DetailScopeBtn" Content="选择范围" Style="{StaticResource GhostButton}" Padding="8,3" FontSize="11"
                            Click="DetailScope_Click"/>
                    <TextBlock x:Name="DetailScopeHint" Margin="10,0,0,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMuted}" FontSize="10.5" TextWrapping="Wrap"/>
                  </StackPanel>
                  <DockPanel DockPanel.Dock="Bottom" Margin="14,8,12,12" LastChildFill="True">
                    <TextBlock x:Name="DetailMoreHint" DockPanel.Dock="Right" VerticalAlignment="Center"
                               Margin="10,0,0,0" Foreground="{DynamicResource TextMuted}" FontSize="11"/>
                    <Button x:Name="DetailMoreBtn" Content="加载更多" Style="{StaticResource GhostButton}" Padding="12,4"
                            HorizontalAlignment="Left" FontSize="11" Click="DetailMore_Click"/>
                  </DockPanel>
                  <DataGrid x:Name="CleanGrid" AutoGenerateColumns="False" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0" RowHeight="30" Margin="0,0,4,0"
                      AlternatingRowBackground="{DynamicResource RowAlt}"
                      RowBackground="{DynamicResource PanelRight}" Background="{DynamicResource PanelRight}"
                      HorizontalGridLinesBrush="{DynamicResource GridLine}" EnableRowVirtualization="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      VerticalContentAlignment="Center"
                      HorizontalScrollBarVisibility="Disabled"
                      MouseDoubleClick="CleanGrid_MouseDoubleClick"
                      MouseLeftButtonUp="CleanGrid_Click"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.CacheLength="1,1"
                      VirtualizingPanel.CacheLengthUnit="Page"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
                      <!-- EnableRowVirtualization 只管「不分组」的情况。本表格是分组的，
                           分组虚拟化由 IsVirtualizingWhenGrouping 单独控制且默认为 false ——
                           不显式打开，几十万条候选会被整批物化成行容器。 -->
                      <DataGrid.ContextMenu>
                        <ContextMenu>
                          <MenuItem x:Name="CleanOpenItem" Header="在资源管理器中打开" Click="CleanOpen_Click"/>
                        </ContextMenu>
                      </DataGrid.ContextMenu>
                      <DataGrid.GroupStyle>
                        <GroupStyle>
                          <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                              <Setter Property="Template">
                                <Setter.Value>
                                  <ControlTemplate TargetType="{x:Type GroupItem}">
                                    <!-- 分组标题 + **共同说明只出现这一次**，组内文件行不再重复。
                                         标准 Expander 箭头，键盘可操作。 -->
                                    <StackPanel>
                                      <Expander IsExpanded="{Binding Name, Converter={StaticResource DetailGroupExpanded}, Mode=OneWay}"
                                                Background="Transparent" BorderThickness="0" Padding="0"
                                                AutomationProperties.Name="{Binding Converter={StaticResource DetailGroupHeader}, Path=Title}">
                                        <Expander.Header>
                                          <Grid Margin="0,6,6,2"
                                                DataContext="{Binding Converter={StaticResource DetailGroupHeader}}">
                                            <Grid.ColumnDefinitions>
                                              <ColumnDefinition Width="*"/>
                                              <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                              <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                                                         Foreground="{DynamicResource Text}"
                                                         TextTrimming="CharacterEllipsis"/>
                                              <TextBlock Text="{Binding Note}" FontSize="11" Margin="0,2,0,0"
                                                         Foreground="{DynamicResource TextDim}" TextWrapping="Wrap"
                                                         MaxHeight="32"
                                                         ToolTip="{Binding Note}"
                                                         Visibility="{Binding HasNote, Converter={StaticResource BoolToVisible}}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                                        VerticalAlignment="Top" Margin="10,1,0,0">
                                              <TextBlock Text="{Binding SelectedText}" FontSize="11"
                                                         Foreground="{DynamicResource Accent}"
                                                         Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisible}}"/>
                                              <TextBlock Text="{Binding Stat}" FontSize="11.5" Margin="8,0,0,0"
                                                         Foreground="{DynamicResource TextDim}"/>
                                            </StackPanel>
                                          </Grid>
                                        </Expander.Header>
                                        <ItemsPresenter/>
                                      </Expander>
                                      <!-- 细分隔线区分分组，不用卡片套卡片 -->
                                      <Border Height="1" Background="{DynamicResource GridLine}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                  </ControlTemplate>
                                </Setter.Value>
                              </Setter>
                            </Style>
                          </GroupStyle.ContainerStyle>
                        </GroupStyle>
                      </DataGrid.GroupStyle>
              <DataGrid.Columns>
                <DataGridCheckBoxColumn x:Name="ColPick" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="34" MinWidth="34" CanUserResize="False">
                  <DataGridCheckBoxColumn.Header>
                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                              ToolTip="全选 / 取消全选" Click="PickAll_Click"/>
                  </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn x:Name="ColCleanType" Header="类型" Binding="{Binding Group}" SortMemberPath="Group" Width="64" MinWidth="64" CanUserResize="False" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Center"/>
                      <Setter Property="FontSize" Value="11"/>
                      <Setter Property="ToolTip" Value="{Binding HintText}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Risk}" Value="Safe">
                          <Setter Property="Foreground" Value="{DynamicResource ToneGreenAccent}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Risk}" Value="Confirm">
                          <Setter Property="Foreground" Value="{DynamicResource ToneYellowAccent}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Risk}" Value="Keep">
                          <Setter Property="Foreground" Value="{DynamicResource ToneRedAccent}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColCleanName" Header="文件名" Binding="{Binding Name}" Width="2*" MinWidth="140" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="ToolTip" Value="{Binding Name}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColCleanSize" Header="大小" Binding="{Binding SizeText}" SortMemberPath="Size" Width="78" MinWidth="78" CanUserResize="False" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
                </DockPanel>
              </Border>
            </Grid>
          </DockPanel>
          <DockPanel x:Name="UninstallPane" Visibility="Collapsed">
            <StackPanel x:Name="UninstallProgressPanel" DockPanel.Dock="Top" Margin="16,10,16,0" Visibility="Collapsed">
              <TextBlock x:Name="UninstallProgressText" Foreground="{DynamicResource TextDim}" FontSize="11" Margin="0,0,0,6"/>
              <ProgressBar x:Name="UninstallProgressBar" Height="6" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <!-- 只讲事实：极简表头 -->
            <Border DockPanel.Dock="Top" Margin="20,10,20,8" Padding="14,10"
                    CornerRadius="10" Background="{DynamicResource CardSurface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <TextBlock x:Name="UninstallSummary" Foreground="{DynamicResource TextDim}" FontSize="12"
                         TextWrapping="Wrap" Text="已安装软件，按占用从大到小。"/>
            </Border>
            <TextBlock x:Name="UninstallSortNote" Visibility="Collapsed"/>
            <Border DockPanel.Dock="Bottom" Margin="20,8,20,14" Padding="14,9"
                    CornerRadius="10" Background="{DynamicResource CardSurface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="UninstallRunBtn" Content="卸载勾选项" Style="{StaticResource OrangePillButton}"
                        Padding="20,7" FontSize="12.5" Click="UninstallRun_Click"/>
                <!-- 残留：只作为卸载之后的可选收尾动作，勾选「安全残留」仍走同一条确认链路 -->
                <Button x:Name="JunkSafeBtn" Content="勾选安全残留" Style="{StaticResource GhostButton}"
                        Margin="8,0,0,0" Click="JunkSafe_Click" Visibility="Collapsed"/>
                <Button x:Name="JunkDeleteBtn" Content="删除残留" Style="{StaticResource DangerButton}"
                        Margin="8,0,0,0" Click="JunkDelete_Click" Visibility="Collapsed"/>
                <TextBlock x:Name="UninstallSelHint" Margin="12,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextDim}" FontSize="11.5"/>
              </StackPanel>
            </Border>
            <Border Margin="20,0,20,0" CornerRadius="10" Background="{DynamicResource PanelRight}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1" ClipToBounds="True">
            <Grid>
            <!-- 唯一的表格：铺满整行宽度。没有分组表头、没有建议列 —— 只讲事实。
                 默认排序固定在「占用」列（有效占用降序，未知最后），仍允许用户点表头改看别的列。 -->
            <DataGrid x:Name="UninstallGrid" AutoGenerateColumns="False" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="40" Margin="0"
                      AlternatingRowBackground="{DynamicResource RowAlt}"
                      RowBackground="{DynamicResource PanelRight}" Background="{DynamicResource PanelRight}"
                      HorizontalGridLinesBrush="{DynamicResource GridLine}" EnableRowVirtualization="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      HorizontalScrollBarVisibility="Disabled"
                      MouseLeftButtonUp="UninstallGrid_Click"
                      MouseDoubleClick="UninstallGrid_DoubleClick"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.ScrollUnit="Pixel">
              <DataGrid.ContextMenu>
                <ContextMenu>
                  <MenuItem x:Name="UninstallRetryItem" Header="重试卸载" Click="UninstallRetry_Click"/>
                  <MenuItem x:Name="UninstallOpenOfficialItem" Header="打开官方卸载程序" Click="UninstallOpenOfficial_Click"/>
                </ContextMenu>
              </DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridCheckBoxColumn x:Name="ColAppPick" Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="40" CanUserSort="False" CanUserResize="False">
                  <DataGridCheckBoxColumn.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                      <Setter Property="Padding" Value="10,0,0,0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Left"/>
                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                      <Setter Property="IsEnabled" Value="{Binding CanUninstall}"/>
                    </Style>
                  </DataGridCheckBoxColumn.CellStyle>
                  <DataGridCheckBoxColumn.ElementStyle>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                      <Setter Property="HorizontalAlignment" Value="Left"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="IsEnabled" Value="{Binding CanUninstall}"/>
                    </Style>
                  </DataGridCheckBoxColumn.ElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridTemplateColumn Width="40" CanUserSort="False" CanUserResize="False">
                  <DataGridTemplateColumn.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                      <Setter Property="Padding" Value="4,0,8,0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                  </DataGridTemplateColumn.CellStyle>
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <Image Source="{Binding Icon}" Width="18" Height="18" Stretch="Uniform"
                             RenderOptions.BitmapScalingMode="HighQuality"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn x:Name="ColAppName" Header="名称" Binding="{Binding Name}" Width="*" MinWidth="140" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="ToolTip" Value="{Binding Name}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- 2.12：发布者 / 版本 / 状态三列从可见表格里移除（保留元素以便随时恢复，
                     但不再占位、不再显示）。默认排序仍由「占用」列的数字字段决定。 -->
                <DataGridTextColumn x:Name="ColAppPub" Header="发布者" Binding="{Binding Publisher}" Width="150" MinWidth="90" IsReadOnly="True"
                                    Visibility="Collapsed">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="ToolTip" Value="{Binding Publisher}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColAppVersion" Header="版本" Binding="{Binding Version}" Width="104" MinWidth="70" IsReadOnly="True"
                                    Visibility="Collapsed">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="ToolTip" Value="{Binding Version}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColAppInstallDate" Header="安装日期" Binding="{Binding InstallDateText}" Width="104" MinWidth="92" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- 用途：只讲「这是什么软件」这一条事实（后端 AppFactualInfoService 产出）。
                     没有建议、没有评分、没有分组结论。 -->
                <DataGridTextColumn x:Name="ColAppPurpose" Header="用途" Binding="{Binding PurposeText}"
                                    Width="2*" MinWidth="150" IsReadOnly="True" CanUserSort="False">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                      <Setter Property="ToolTip" Value="{Binding PurposeHint}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- 占用：默认排序按**有效大小**降序（实测优先，其次安装记录，未知永远最后）。
                     这里不显示任何建议/评分，只显示数字与它的来源提示。 -->
                <DataGridTextColumn x:Name="ColAppSize" Header="占用" Binding="{Binding ActualSizeText}"
                                    SortMemberPath="EffectiveFootprintBytes"
                                    Width="92" MinWidth="80" IsReadOnly="True">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="HorizontalAlignment" Value="Right"/>
                      <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                      <!-- 悬停说清这个数从哪来：扫描实测 / 安装记录写的 / 未知；
                           没测到还要说清为什么（共享目录、系统目录、不在扫描范围…）。
                           磁盘占用不等于卸载可释放量。 -->
                      <Setter Property="ToolTip" Value="{Binding FootprintHint}"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <DataGridTextColumn x:Name="ColAppStatus" Header="状态" Binding="{Binding Status}" Width="86" MinWidth="72" IsReadOnly="True" CanUserSort="False"
                                    Visibility="Collapsed">
                  <DataGridTextColumn.ElementStyle>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                      <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    </Style>
                  </DataGridTextColumn.ElementStyle>
                </DataGridTextColumn>
                <!-- 有用的卸载动作：打开官方卸载程序 / 打开安装目录（都不自动执行） -->
                <DataGridTemplateColumn x:Name="ColAppAction" Header="操作" Width="Auto" MinWidth="84" CanUserSort="False" CanUserResize="False" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26" Margin="0,0,2,0"
                                Click="UninstallOpenOfficial_Click"
                                IsEnabled="{Binding CanUninstall}"
                                ToolTip="打开官方卸载程序（会弹出软件自己的卸载窗口）"
                                AutomationProperties.Name="打开官方卸载程序">
                          <Path Data="{StaticResource IconLink}" Width="13" Height="13" Stretch="Uniform"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                Click="UninstallReveal_Click"
                                ToolTip="打开安装目录（不会执行里面的程序）"
                                AutomationProperties.Name="打开安装目录">
                          <Path Data="{StaticResource IconFolderOpen}" Width="13" Height="13" Stretch="Uniform"
                                Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        </Button>
                      </StackPanel>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
              </DataGrid.Columns>
            </DataGrid>
            <DataGrid x:Name="JunkGrid" AutoGenerateColumns="False" CanUserSortColumns="True"
                      HeadersVisibility="Column" GridLinesVisibility="None"
                      BorderThickness="0" RowHeight="32" Margin="12,0,16,0" Visibility="Collapsed"
                      AlternatingRowBackground="{DynamicResource RowAlt}"
                      RowBackground="{DynamicResource PanelRight}" Background="{DynamicResource PanelRight}"
                      HorizontalGridLinesBrush="{DynamicResource GridLine}" EnableRowVirtualization="True"
                      SelectionMode="Single" SelectionUnit="FullRow"
                      MouseLeftButtonUp="JunkGrid_Click"
                      MouseDoubleClick="JunkGrid_DoubleClick">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="" Binding="{Binding Selected, UpdateSourceTrigger=PropertyChanged}" Width="40">
                  <DataGridCheckBoxColumn.CellStyle>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                      <Setter Property="Padding" Value="10,0,0,0"/>
                      <Setter Property="HorizontalContentAlignment" Value="Left"/>
                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                    </Style>
                  </DataGridCheckBoxColumn.CellStyle>
                  <DataGridCheckBoxColumn.ElementStyle>
                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                      <Setter Property="HorizontalAlignment" Value="Left"/>
                      <Setter Property="VerticalAlignment" Value="Center"/>
                      <Setter Property="Margin" Value="0"/>
                    </Style>
                  </DataGridCheckBoxColumn.ElementStyle>
                </DataGridCheckBoxColumn>
                <DataGridTextColumn x:Name="ColJunkApp" Header="名称" Binding="{Binding AppName}" Width="140" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColJunkKind" Header="类型" Binding="{Binding Category}" Width="80" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColJunkConf" Header="把握" Binding="{Binding ConfidenceText}" SortMemberPath="ConfidenceScore" Width="72" IsReadOnly="True"/>
                <DataGridTextColumn x:Name="ColJunkPath" Header="路径" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
              </DataGrid.Columns>
            </DataGrid>
            </Grid>
            </Border>
          </DockPanel>
        </Grid>
      </Border>
    </Grid>
  </DockPanel>

  <!-- 弹层 = 遮罩 + 内容**两层**，不是父子套在一起。
       以前 DialogCard 是 Overlay 的子元素，而淡入淡出动画改的是 Overlay.Opacity，
       WPF 的 Opacity 会**乘到子元素上**，于是动画期间弹层内容自己也是半透明的，
       后面的列表直接从弹层里透出来（截图里那个重叠现象）。
       现在遮罩单独动画，卡片始终保持不透明，只做轻微的缩放。 -->
  <Grid x:Name="OverlayRoot" Visibility="Collapsed">
    <Border x:Name="Overlay" Background="{DynamicResource Overlay}" Opacity="0"
            MouseLeftButtonDown="Overlay_Click"/>
    <Border x:Name="DialogCard" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1"
            CornerRadius="14" Width="520" MaxHeight="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,20"
            RenderTransformOrigin="0.5,0.5" Focusable="True" KeyboardNavigation.TabNavigation="Cycle"
            MouseLeftButtonDown="Dialog_Click">
      <Border.Effect>
        <DropShadowEffect BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#000000"/>
      </Border.Effect>
      <Border.RenderTransform>
        <TransformGroup>
          <ScaleTransform x:Name="DialogScale" ScaleX="0.96" ScaleY="0.96"/>
          <TranslateTransform x:Name="DialogTranslate" Y="12"/>
        </TransformGroup>
      </Border.RenderTransform>
      <StackPanel>
        <Grid Margin="0,0,0,14">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <Button x:Name="ProvEditBackBtn" Grid.Column="0" Style="{StaticResource IconButton}"
                  Width="28" Height="28" Margin="0,0,6,0" Visibility="Collapsed"
                  Click="ProvEditBack_Click" ToolTip="返回">
            <Path Data="{StaticResource IconChevronLeft}" Width="11" Height="11" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
          <TextBlock x:Name="DialogTitle" Grid.Column="1" FontSize="15.5" FontWeight="SemiBold"
                     Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
          <Button x:Name="DialogCloseX" Grid.Column="2" Style="{StaticResource IconButton}"
                  Width="28" Height="28" Click="CloseOverlay_Click" ToolTip="关闭">
            <Path Data="{StaticResource IconClose}" Width="10" Height="10" Stretch="Uniform"
                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
          </Button>
        </Grid>

        <ScrollViewer x:Name="SettingsBody" MaxHeight="500" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- 顶部双页签：默认进入「AI 模型」，次要设置折叠到「常规设置」 -->
            <Border Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="4"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="SettingsTabAiBtn" Grid.Column="0" Style="{StaticResource SegmentedTabButton}"
                        Tag="Ai" Click="SettingsTab_Click"/>
                <Button x:Name="SettingsTabGeneralBtn" Grid.Column="2" Style="{StaticResource SegmentedTabButton}"
                        Tag="General" Click="SettingsTab_Click"/>
              </Grid>
            </Border>

            <!-- 页签 1：AI 模型 -->
            <StackPanel x:Name="SettingsAiPane">
              <!-- 当前使用中的 AI 摘要条 -->
              <Border Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1" CornerRadius="10" Padding="14,11" Margin="0,0,0,12">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Ellipse x:Name="AiActiveDot" Grid.Column="0" Width="8" Height="8"
                           VerticalAlignment="Center" Margin="0,0,10,0" Fill="#8A8A8A"/>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="AiActiveTitle" Foreground="{DynamicResource TextMuted}" FontSize="10.5" Margin="0,0,0,2"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock x:Name="AiActiveName" Foreground="{DynamicResource Text}" FontWeight="SemiBold" FontSize="13.5"/>
                      <TextBlock x:Name="AiActiveModel" Foreground="{DynamicResource TextMuted}" FontSize="11.5"
                                 FontFamily="{DynamicResource MonoFont}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="AiActiveStatus" Foreground="{DynamicResource TextMuted}" FontSize="11"
                               TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                  </StackPanel>
                  <Button x:Name="AiActiveEditBtn" Grid.Column="2" Style="{StaticResource GhostButton}"
                          Padding="10,5" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"
                          Click="AiActiveEdit_Click"/>
                </Grid>
              </Border>

              <!-- 保留命名字段供多语言同步，界面上折叠隐藏保持极简 -->
              <TextBlock x:Name="AiSectionLabel" Visibility="Collapsed"/>
              <TextBlock x:Name="AiSectionHint" Visibility="Collapsed"/>

              <ItemsControl x:Name="AiProvCards" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                            Cursor="Hand" MouseLeftButtonDown="AiProvCard_MouseDown">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource PanelLeft}"/>
                          <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                          <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                              <Setter Property="Background" Value="{DynamicResource BrandAccentSoft}"/>
                              <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Style="{StaticResource ProviderRadioStyle}"
                                     GroupName="AiActiveProv" VerticalAlignment="Center"
                                     Margin="0,0,10,0" Tag="{Binding}" Click="AiUseProv_Click"
                                     IsChecked="{Binding IsActive, Mode=OneWay}"
                                     ToolTip="{Binding UseTip}"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Text}" FontSize="13"
                                       FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Border Margin="8,0,0,0" Padding="6,1" CornerRadius="4"
                                    Background="{DynamicResource BrandAccent}"
                                    VerticalAlignment="Center">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                      <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding ActiveLabel}" Foreground="{DynamicResource BrandAccentFg}"
                                         FontWeight="SemiBold" FontSize="10"/>
                            </Border>
                            <Ellipse Width="7" Height="7" Margin="7,0,0,0" VerticalAlignment="Center"
                                     ToolTip="{Binding StatusTip}">
                              <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                  <Setter Property="Fill" Value="#8A8A8A"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="ok">
                                      <Setter Property="Fill" Value="#3ECF6A"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="warn">
                                      <Setter Property="Fill" Value="#E0B050"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusKind}" Value="fail">
                                      <Setter Property="Fill" Value="#E07070"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Ellipse.Style>
                            </Ellipse>
                          </StackPanel>
                          <TextBlock Text="{Binding ModelLabel}" Foreground="{DynamicResource TextMuted}" FontSize="11"
                                     FontFamily="{DynamicResource MonoFont}" Margin="0,2,0,0"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                          <Button Content="{Binding EditLabel}" Style="{StaticResource GhostButton}"
                                  Padding="10,4" FontSize="11" Margin="0,0,4,0"
                                  Click="AiEditProv_Click" Tag="{Binding}"/>
                          <Button Style="{StaticResource IconButton}" Width="26" Height="26"
                                  Foreground="{DynamicResource TextMuted}"
                                  Click="AiDelProvCard_Click" Tag="{Binding}"
                                  ToolTip="{Binding DeleteLabel}">
                            <Path Data="{StaticResource IconTrash}" Width="12" Height="12" Stretch="Uniform"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                          </Button>
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Button x:Name="AiAddProvBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"
                      Height="36" FontSize="12" Padding="10,0" Margin="0" Click="AiAddProv_Click"/>
            </StackPanel>

            <!-- 页签 2：常规设置 -->
            <StackPanel x:Name="SettingsGeneralPane" Visibility="Collapsed">
              <Border Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1" CornerRadius="10" Padding="14,12">
                <StackPanel>
                  <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button x:Name="ThemeLightBtn" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                              Padding="12,5" FontSize="12" Click="ThemeChoice_Click" Tag="Light"/>
                      <Button x:Name="ThemeDarkBtn" Style="{StaticResource GhostButton}"
                              Padding="12,5" FontSize="12" Click="ThemeChoice_Click" Tag="Dark"/>
                    </StackPanel>
                    <TextBlock x:Name="ThemeLabel" Foreground="{DynamicResource Text}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>
                  <DockPanel Margin="0,0,0,10">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                      <Button x:Name="LangZhBtn" Style="{StaticResource GhostButton}" Margin="0,0,6,0"
                              Padding="12,5" FontSize="12" Click="Lang_Click" Tag="Zh"/>
                      <Button x:Name="LangEnBtn" Style="{StaticResource GhostButton}"
                              Padding="12,5" FontSize="12" Click="Lang_Click" Tag="En"/>
                    </StackPanel>
                    <TextBlock x:Name="LangLabel" Foreground="{DynamicResource Text}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                  </DockPanel>
                  <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,10"/>
                  <Grid>
                    <TextBlock x:Name="DiagHint" Foreground="{DynamicResource TextMuted}" FontSize="11"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,115,0"/>
                    <Button x:Name="DiagExportBtn" Style="{StaticResource GhostButton}" HorizontalAlignment="Right"
                            Padding="10,5" FontSize="11.5" Click="DiagExport_Click"/>
                  </Grid>
                </StackPanel>
              </Border>
              <Button x:Name="AboutLinkBtn" Style="{StaticResource GhostButton}" Margin="0,12,0,0"
                      HorizontalAlignment="Left" Padding="12,6" FontSize="12" Click="AboutButton_Click"
                      Content="关于大扫货"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="ProvEditBody" MaxHeight="520" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <!-- 隐藏但保留命名节点，确保现有回归断言与多语言同步兼容 -->
            <TextBlock x:Name="AiSetupTitle" Visibility="Collapsed"/>
            <TextBlock x:Name="AiSetupHint" Visibility="Collapsed"/>
            <TextBlock x:Name="AiPresetLabel" Visibility="Collapsed"/>
            <ComboBox x:Name="AiPresetBox" Visibility="Collapsed" SelectionChanged="AiPreset_Changed"/>
            <TextBlock x:Name="AiPresetHint" Visibility="Collapsed"/>
            <TextBlock x:Name="AiPrivacyTitle" Visibility="Collapsed"/>
            <TextBlock x:Name="AiDecisionsHintText" Visibility="Collapsed"/>
            <Expander x:Name="AiAdvancedExpander" Visibility="Collapsed">
              <Expander.Header>
                <TextBlock x:Name="AiAdvancedLabel"/>
              </Expander.Header>
              <TextBlock x:Name="AiAdvancedHint"/>
            </Expander>

            <!-- 一键预设分段栏 -->
            <Border Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="9" Padding="3" Margin="0,0,0,14">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="3"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="PresetBtnDeepSeek" Grid.Column="0" Style="{StaticResource SegmentedTabButton}"
                        Content="DeepSeek" Tag="0" Click="AiPresetPill_Click"/>
                <Button x:Name="PresetBtnOpenAi" Grid.Column="2" Style="{StaticResource SegmentedTabButton}"
                        Content="OpenAI" Tag="1" Click="AiPresetPill_Click"/>
                <Button x:Name="PresetBtnOllama" Grid.Column="4" Style="{StaticResource SegmentedTabButton}"
                        Content="Ollama" Tag="2" Click="AiPresetPill_Click"/>
                <Button x:Name="PresetBtnCustom" Grid.Column="6" Style="{StaticResource SegmentedTabButton}"
                        Content="自定义" Tag="3" Click="AiPresetPill_Click"/>
              </Grid>
            </Border>

            <!-- 显示名称 -->
            <TextBlock x:Name="AiNameLabel" Foreground="{DynamicResource TextDim}" FontSize="11.5"
                       FontWeight="Medium" Margin="0,0,0,5"/>
            <TextBox x:Name="AiNameBox" Style="{StaticResource TermTextBox}" Margin="0,0,0,12"
                     Height="36" Tag="显示名称"/>

            <!-- 接口地址 -->
            <TextBlock x:Name="AiUrlLabel" Foreground="{DynamicResource TextDim}" FontSize="11.5"
                       FontWeight="Medium" Margin="0,0,0,5"/>
            <TextBox x:Name="AiUrlBox" Style="{StaticResource TermTextBox}" Margin="0,0,0,12"
                     Height="36" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                     Tag="https://api.deepseek.com/v1"
                     TextChanged="AiProviderField_TextChanged"/>

            <!-- 模型 + 线上拉取 -->
            <TextBlock x:Name="AiDecisionsModelLabel" Foreground="{DynamicResource TextDim}" FontSize="11.5"
                       FontWeight="Medium" Margin="0,0,0,5"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBox x:Name="AiDecisionModelBox" Style="{StaticResource TermTextBox}"
                       Height="36" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                       Margin="0,0,8,0" Tag="deepseek-chat"
                       TextChanged="AiProviderField_TextChanged"/>
              <Button x:Name="AiFetchModelsBtn" Grid.Column="1" Style="{StaticResource GhostButton}"
                      Height="36" Padding="12,0" FontSize="11.5" Click="AiFetchModels_Click"/>
            </Grid>
            <Popup x:Name="AiModelsPopup" PlacementTarget="{Binding ElementName=AiDecisionModelBox}"
                   Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
              <Border Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource Border}"
                      BorderThickness="1" CornerRadius="8" Padding="2" MaxHeight="240"
                      Width="{Binding ActualWidth, ElementName=AiDecisionModelBox}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <ListBox x:Name="AiModelsList" Background="Transparent" BorderThickness="0"
                           ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                           SelectionChanged="AiModelsList_SelectionChanged">
                    <ListBox.ItemContainerStyle>
                      <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Padding" Value="10,6"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <Border x:Name="bd" Background="{TemplateBinding Background}"
                                      CornerRadius="5" Margin="3,1"
                                      Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource SelectBg}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                  <Setter TargetName="bd" Property="Background" Value="{DynamicResource BrandAccentSoft}"/>
                                  <Setter Property="Foreground" Value="{DynamicResource BrandAccent}"/>
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding}" FontSize="12" FontFamily="{DynamicResource MonoFont}"
                                   TextTrimming="CharacterEllipsis" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </ScrollViewer>
              </Border>
            </Popup>
            <TextBlock x:Name="AiModelsHint" Foreground="{DynamicResource TextMuted}" FontSize="11"
                       TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,8"/>

            <!-- API 密钥（支持明暗文切换 + 一键清空） -->
            <DockPanel Margin="0,8,0,5">
              <Button x:Name="AiKeyClearBtn" DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                      Padding="8,1" FontSize="10.5" BorderThickness="0" Background="Transparent"
                      Click="AiKeyClear_Click"/>
              <TextBlock x:Name="AiKeyLabel" Foreground="{DynamicResource TextDim}" FontSize="11.5"
                         FontWeight="Medium" VerticalAlignment="Center"/>
            </DockPanel>
            <Border x:Name="AiKeyInputBorder" BorderThickness="1" CornerRadius="8" Height="36">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource PanelLeft}"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
                  <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource AccentDim}"/>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                      <Setter Property="BorderBrush" Value="{DynamicResource BrandAccent}"/>
                    </Trigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="AiKeyBox" Grid.Column="0" Height="34" Padding="11,0,6,0"
                             VerticalContentAlignment="Center" FontSize="12.5"
                             Background="Transparent" Foreground="{DynamicResource Text}"
                             BorderThickness="0" CaretBrush="{DynamicResource BrandAccent}"
                             PasswordChanged="AiKeyBox_PasswordChanged"/>
                <TextBox x:Name="AiKeyPlainBox" Grid.Column="0" Height="34" Padding="11,0,6,0"
                         VerticalContentAlignment="Center" Visibility="Collapsed"
                         FontFamily="{DynamicResource MonoFont}" FontSize="12"
                         Background="Transparent" Foreground="{DynamicResource Text}"
                         BorderThickness="0" CaretBrush="{DynamicResource BrandAccent}"
                         TextChanged="AiKeyPlainBox_TextChanged"/>
                <Button x:Name="AiKeyRevealBtn" Grid.Column="1" Style="{StaticResource IconButton}"
                        Width="32" Height="32" Margin="0,0,2,0" Click="AiKeyReveal_Click"
                        ToolTip="显示/隐藏密钥">
                  <Path x:Name="AiKeyRevealIcon" Data="{StaticResource IconEye}" Width="14" Height="14" Stretch="Uniform"
                        Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                </Button>
              </Grid>
            </Border>
            <TextBlock x:Name="AiKeyHint" Foreground="{DynamicResource TextMuted}" FontSize="10.5"
                       TextWrapping="Wrap" Margin="0,4,0,0"/>

            <!-- 连通性测试结果卡 -->
            <Border Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                    BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,14,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="AiTestBtn" Style="{StaticResource GhostButton}" Click="AiTest_Click"
                          Height="32" Padding="14,0" FontSize="12" FontWeight="SemiBold"
                          VerticalAlignment="Center"/>
                  <!-- 用 Grid 的 * 列约束宽度，长诊断才会换行；横向 StackPanel 会给
                       TextBlock 无限宽度，长句直接被弹层裁掉。 -->
                  <TextBlock x:Name="AiTestHint" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextDim}" FontSize="11.5" TextWrapping="Wrap"/>
                </Grid>
                <TextBlock x:Name="AiDiagnosticNext" Foreground="{DynamicResource TextMuted}" FontSize="11"
                           TextWrapping="Wrap" Visibility="Collapsed" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
        <StackPanel x:Name="AboutBody" Visibility="Collapsed">
          <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="Assets/logo-256.png" Width="56" Height="56"
                   VerticalAlignment="Top" Margin="0,2,14,0"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="AboutAppTitle" Text="大扫货" FontSize="16" FontWeight="SemiBold"
                           Foreground="{DynamicResource Text}" VerticalAlignment="Center"/>
                <Border Margin="8,0,0,0" Padding="7,1.5" CornerRadius="5"
                        Background="{DynamicResource BrandAccentSoft}" VerticalAlignment="Center">
                  <TextBlock x:Name="AboutVersionBadge" Text="v3.0.0" FontSize="10.5"
                             FontWeight="SemiBold" Foreground="{DynamicResource BrandAccent}"/>
                </Border>
              </StackPanel>
              <TextBlock x:Name="AboutText" Foreground="{DynamicResource TextDim}" FontSize="12"
                         TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Grid>
          <Border Background="{DynamicResource PanelLeft}" BorderBrush="{DynamicResource Border}"
                  BorderThickness="1" CornerRadius="10" Padding="14,11">
            <StackPanel>
              <DockPanel Margin="0,0,0,9">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="AboutQqText" Text="953854287" FontSize="12.5" FontWeight="SemiBold"
                             FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource Text}"
                             VerticalAlignment="Center"/>
                  <Button x:Name="AboutQqCopyBtn" Style="{StaticResource GhostButton}"
                          Padding="8,2" FontSize="11" Margin="8,0,0,0" Click="AboutQqCopy_Click"/>
                </StackPanel>
                <TextBlock x:Name="AboutQqLabel" Text="联系 QQ" FontSize="12"
                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
              </DockPanel>
              <Border Height="1" Background="{DynamicResource Border}" Margin="0,0,0,9"/>
              <DockPanel>
                <TextBlock x:Name="RepoLink" DockPanel.Dock="Right" FontSize="11.5"
                           Foreground="{DynamicResource BrandAccent}" Cursor="Hand"
                           TextDecorations="Underline" VerticalAlignment="Center"
                           MouseLeftButtonDown="RepoLink_Click"/>
                <TextBlock x:Name="AboutRepoLabel" Text="项目主页" FontSize="12"
                           Foreground="{DynamicResource TextDim}" VerticalAlignment="Center"/>
              </DockPanel>
            </StackPanel>
          </Border>
        </StackPanel>
        <ScrollViewer x:Name="ScanDetailsBody" MaxHeight="480" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ScanDetailsContent"/>
        </ScrollViewer>
        <ScrollViewer x:Name="AlertBody" MaxHeight="360" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="AlertText" Foreground="{DynamicResource Text}" TextWrapping="Wrap" Margin="0,0,0,8"/>
        </ScrollViewer>

        <!-- ===== 查看已选：结构化清单，不再是「一大段文字」 =====
             顶部是准确口径的统计，下面按用途分组列出位置、候选项数与预计空间。
             用 DataGrid（已开虚拟化）承载，选择可能上十万条时不会一次性建行。 -->
        <Grid x:Name="SelectionBody" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- 统计口径写清楚是「候选项」还是「位置」，不与文件数混用 -->
          <TextBlock x:Name="SelectionSummaryText" Grid.Row="0" Foreground="{DynamicResource Text}"
                     FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="SelectionSubText" Grid.Row="1" Margin="0,4,0,10"
                     Foreground="{DynamicResource TextMuted}" FontSize="11" TextWrapping="Wrap"/>
          <DataGrid x:Name="SelectionGrid" Grid.Row="2" MinHeight="200" MaxHeight="360"
                    AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                    GridLinesVisibility="None" BorderThickness="0" RowHeight="30"
                    Background="Transparent" RowBackground="Transparent"
                    AlternatingRowBackground="{DynamicResource RowAlt}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.VirtualizationMode="Recycling"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalContentAlignment="Center">
            <DataGrid.Columns>
              <DataGridTextColumn Header="用途" Binding="{Binding Purpose}" Width="110" IsReadOnly="True"/>
              <DataGridTextColumn Header="位置 / 名称" Binding="{Binding Label}" Width="*" MinWidth="140" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding FullPath}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="候选项" Binding="{Binding ItemCountText}" Width="72" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Margin" Value="0,0,10,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="预计空间" Binding="{Binding SizeText}" Width="86" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <!-- 长路径截断显示，完整路径在悬停里；这一列提供复制入口 -->
              <DataGridTemplateColumn Header="" Width="64" IsReadOnly="True">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <Button Style="{StaticResource ChipButton}" Padding="7,2" FontSize="10.5"
                            Content="复制路径" Click="SelectionCopyPath_Click"
                            ToolTip="{Binding FullPath}"
                            AutomationProperties.Name="复制这个位置的完整路径"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <!-- ===== 规则明确的批量勾选：预览 + 逐类排除 =====
             它只决定「勾哪些」，不执行任何删除；确认后仍然走清理前检查。 -->
        <Grid x:Name="RuleSelectBody" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <TextBlock x:Name="RuleSelectSummary" Grid.Row="0" Foreground="{DynamicResource Text}"
                     FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap"/>
          <TextBlock x:Name="RuleSelectExcluded" Grid.Row="1" Margin="0,4,0,0"
                     Foreground="{DynamicResource AccentDim}" FontSize="11" TextWrapping="Wrap"
                     Visibility="Collapsed"/>
          <DataGrid x:Name="RuleSelectGrid" Grid.Row="2" Margin="0,10,0,0" MinHeight="180" MaxHeight="320"
                    AutoGenerateColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                    BorderThickness="0" RowHeight="46" Background="Transparent" RowBackground="Transparent"
                    AlternatingRowBackground="{DynamicResource RowAlt}"
                    EnableRowVirtualization="True" EnableColumnVirtualization="True"
                    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                    SelectionMode="Single" SelectionUnit="FullRow"
                    HorizontalScrollBarVisibility="Disabled" VerticalContentAlignment="Center">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="排除" Width="52" CanUserSort="False" IsReadOnly="False">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <CheckBox HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsChecked="{Binding Excluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                              ToolTip="勾上表示这一类不参与本次批量选择"
                              AutomationProperties.Name="{Binding Name}"/>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="类别" Binding="{Binding Name}" Width="110" IsReadOnly="True"/>
              <DataGridTextColumn Header="清掉会怎样" Binding="{Binding Impact}" Width="*" MinWidth="120" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextWrapping" Value="Wrap"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="项数" Binding="{Binding CountText}" Width="60" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Margin" Value="0,0,8,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="约占用" Binding="{Binding SizeText}" Width="80" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                    <Setter Property="Margin" Value="0,0,4,0"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
              <DataGridTextColumn Header="例子" Binding="{Binding SampleText}" Width="150" IsReadOnly="True">
                <DataGridTextColumn.ElementStyle>
                  <Style TargetType="TextBlock">
                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                    <Setter Property="ToolTip" Value="{Binding SampleText}"/>
                    <Setter Property="FontSize" Value="11"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
                  </Style>
                </DataGridTextColumn.ElementStyle>
              </DataGridTextColumn>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>

        <!-- ===== AI 清理报告：可交互建议卡 =====
             AI 只写「建议」和「依据」；加入清理只是勾选候选项，跳到清理页只是换范围。
             真正的删除仍然要用户在清理页显式确认，走预检 + 回收站。 -->
        <ScrollViewer x:Name="ReportBody" MaxHeight="560" Visibility="Collapsed"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="ReportContent"/>
        </ScrollViewer>

        <StackPanel x:Name="ConfirmButtons" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Visibility="Collapsed">
          <Button x:Name="ConfirmNoBtn" Style="{StaticResource GhostButton}" Margin="0,0,8,0" Click="ConfirmNo_Click"/>
          <Button x:Name="ConfirmYesBtn" Style="{StaticResource PrimaryButton}" Click="ConfirmYes_Click"/>
        </StackPanel>
        <Button x:Name="DialogClose" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" Margin="0,20,0,0" Click="CloseOverlay_Click"/>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>
